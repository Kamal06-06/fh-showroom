m}\n  .fqo textarea{width:100%;font:inherit;font-size:.95rem;line-height:1.5;padding:.7rem;border:1px solid var(--line);border-radius:8px;resize:vertical;color:var(--ink);background:#fff}\n  .fqo-actions{display:flex;flex-wrap:wrap;align-items:center;gap:.8rem;margin-top:.7rem}\n  .fqo-hint{font-size:.8rem;color:var(--muted)}\n  .fqo-btn{font:inherit;font-weight:700;border:0;border-radius:8px;background:var(--ink);color:#fff;padding:.7rem 1.2rem;cursor:pointer}\n  .fqo-btn:disabled{opacity:.45;cursor:not-allowed}\n  .fqo-main{width:100%;padding:.95rem;font-size:1rem}\n  .fqo-link{font:inherit;font-size:.85rem;background:none;border:0;color:var(--muted);text-decoration:underline;cursor:pointer;padding:0}\n  .fqo input,.fqo select{font:inherit;font-size:.95rem;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:6px;padding:.5rem .6rem}\n  .fqo input:focus-visible,.fqo select:focus-visible,.fqo textarea:focus-visible,.fqo button:focus-visible{outline:2px solid var(--amber);outline-offset:2px}\n  .fqo-add{position:relative;margin-bottom:1rem}\n  .fqo-add input{width:100%}\n  .fqo-results{list-style:none;margin:.3rem 0 0;padding:0;border:1px solid var(--line);border-radius:6px;background:#fff;overflow:hidden}\n  .fqo-results:empty{display:none}\n  .fqo-results li{display:flex;align-items:center;gap:.6rem;padding:.5rem .7rem;border-top:1px solid var(--line);cursor:pointer}\n  .fqo-results li:first-child{border-top:0}\n  .fqo-results li:hover,.fqo-results li:focus{background:var(--glass);outline:none}\n  .fqo-results img{width:36px;height:36px;object-fit:cover;border-radius:4px}\n  .fqo-rows{display:grid;gap:.6rem}\n  .fqo-row{display:grid;grid-template-columns:56px minmax(0,1fr) auto;gap:.8rem;align-items:start;padding:.8rem;border:1px solid var(--line);border-radius:10px;background:#fff}\n  .fqo-row.is-check{border-color:var(--amber)}\n  .fqo-row.is-bad{border-color:var(--red)}\n  .fqo-row img{width:56px;height:56px;object-fit:cover;border-radius:6px;background:var(--glass)}\n  .fqo-name{font-weight:600;line-height:1.3}\n  .fqo-sku{font-size:.78rem;color:var(--muted);margin-top:.1rem}\n  .fqo-opts{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.5rem;align-items:center}\n  .fqo-opts input[type=number]{width:5.5rem}\n  .fqo-note{font-size:.8rem;margin-top:.4rem}\n  .fqo-row.is-check .fqo-note{color:var(--amber)}\n  .fqo-row.is-bad .fqo-note{color:var(--red)}\n  .fqo-right{text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:.5rem}\n  .fqo-price{font-weight:700;white-space:nowrap}\n  .fqo-x{font:inherit;background:none;border:0;color:var(--muted);cursor:pointer;font-size:1.2rem;line-height:1;padding:.2rem}\n  .fqo-foot{margin-top:1.2rem;padding-top:1rem;border-top:1px solid var(--line)}\n  .fqo-sum{display:flex;justify-content:space-between;align-items:baseline;font-size:1.05rem;margin:.6rem 0}\n  .fqo-sum b{font-size:1.4rem}\n  .fqo-msg{min-height:1.2em;margin:.2rem 0 .6rem;font-size:.85rem;color:var(--red)}\n  @media (max-width:600px){.fqo-row{grid-template-columns:44px minmax(0,1fr)}.fqo-row img{width:44px;height:44px}.fqo-right{grid-column:1/-1;flex-direction:row;justify-content:space-between;align-items:center}}\n</style>\n\n<script>\n(function(){\n  var T={\n    de:{title:'Schnellbestellung',lead:'Für Wiederholungs- und Großbestellungen: Artikelliste einfügen oder Produkte suchen – alles landet mit einem Klick im Warenkorb. Ihre Liste bleibt auf diesem Gerät gespeichert.',\n      pasteLabel:'Liste einfügen (z. B. aus Excel oder WhatsApp)',\n      placeholder:'XJ-NAX-U-16-SH  1 kg  Exklusiv  2\\nNaxos 250 g Standard\\nCH-BLE-H-05-SH 500 g x3',\n      parse:'Liste übernehmen',hint:'Eine Zeile pro Artikel: Code oder Name, Größe, Qualität, Menge.',\n      searchPh:'Produkt hinzufügen: Name oder Artikelcode',clear:'Liste leeren',sum:'Summe',addCart:'Alles in den Warenkorb',\n      adding:'Wird hinzugefügt …',loading:'Wird gesucht …',notFound:'Nicht gefunden – bitte oben neu suchen',\n      check:'Bitte Größe/Qualität prüfen',soldout:'Diese Variante ist nicht verfügbar',qty:'Menge',\n      cartErr:'Nicht hinzugefügt:',toCart:'Zum Warenkorb',noHits:'Kein Produkt gefunden.',remove:'Entfernen'},\n    en:{title:'Quick order',lead:'For repeat and bulk orders: paste your item list or search products – everything goes into the cart with one click. Your list stays saved on this device.',\n      pasteLabel:'Paste list (e.g. from Excel or WhatsApp)',\n      placeholder:'XJ-NAX-U-16-SH  1 kg  Exclusive  2\\nNaxos 250 g Standard\\nCH-BLE-H-05-SH 500 g x3',\n      parse:'Use list',hint:'One line per item: code or name, size, quality, quantity.',\n      searchPh:'Add product: name or product code',clear:'Clear list',sum:'Total',addCart:'Add everything to cart',\n      adding:'Adding …',loading:'Searching …',notFound:'Not found – please search again above',\n      check:'Please check size/quality',soldout:'This variant is not available',qty:'Qty',\n      cartErr:'Not added:',toCart:'Go to cart',noHits:'No product found.',remove:'Remove'}\n  };\n  var loc=((window.Shopify&&Shopify.locale)||document.documentElement.lang||'de').slice(0,2);\n  var L=T[loc]||T.en, ROOT=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';\n  var money=new Intl.NumberFormat(loc==='de'?'de-DE':'en-IE',{style:'currency',currency:'EUR'});\n  var $=function(id){return document.getElementById(id);}, KEY='fh-quickorder';\n  document.querySelectorAll('#fqo [data-t]').forEach(function(el){ if(L[el.dataset.t]) el.textContent=L[el.dataset.t]; });\n  $('fqo-text').placeholder=L.placeholder; $('fqo-q').placeholder=L.searchPh;\n\n  function esc(s){ return String(s==null?'':s).replace(/[&<>\"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c];}); }\n  function norm(s){ return String(s).toLowerCase().replace(/ä/g,'ae').replace(/ö/g,'oe').replace(/ü/g,'ue').replace(/ß/g,'ss')\n    .replace(/[^a-z0-9]/g,'').replace(/exclusive|exklusive|exklusiv/g,'exkl'); }\n  /* Probe pro Gramm: in der Schnellbestellung = Fläschchen à 6 g */\n  var GRE=/pro\\s*gramm|per\\s*gram|بالغرام/i;\n  function isG(v){ return !!v && /-1G$/i.test(v.sku||''); }\n  function unitP(v){ return isG(v) ? v.price*6 : v.price; }\n  function sizeOf(s){ if(GRE.test(String(s))) return {n:6,u:'g'}; var m=String(s).match(/(\\d+(?:[.,]\\d+)?)\\s*(kg|g|ml|liters?|litres?|ltr|l)\\b/i); if(!m) return null;\n    var n=parseFloat(m[1].replace(',','.')), u=m[2].toLowerCase();\n    if(u==='kg') return {n:Math.round(n*1000),u:'g'}; if(u==='g') return {n:Math.round(n),u:'g'};\n    if(u==='ml') return {n:Math.round(n),u:'ml'}; return {n:Math.round(n*1000),u:'ml'}; }\n  function getJSON(u){ return fetch(u,{headers:{Accept:'application/json'}}).then(function(r){ if(!r.ok) throw new Error(r.status); return r.json(); }); }\n  function product(h){ return getJSON(ROOT+'products/'+h+'.js'); }\n  function optVals(p,i){ var o=p.options[i]; return (o&&o.values)?o.values:[]; }\n  function optName(p,i){ var o=p.options[i]; return (o&&o.name)?o.name:String(o||''); }\n  function suggest(q,limit){ return getJSON(ROOT+'search/suggest.json?q='+encodeURIComponent(q)+'&resources[type]=product&resources[limit]='+(limit||6)\n    +'&resources[options][fields]=title,variants.sku,product_type,tag').then(function(d){ return (d.resources&&d.resources.results&&d.resources.results.products)||[]; }); }\n  function img(u,w){ if(!u) return ''; u=String(u); if(u.indexOf('//')===0) u='https:'+u; return u+(u.indexOf('?')>-1?'&':'?')+'width='+w; }\n\n  /* ---------- Zeilen ---------- */\n  var rows=[], uid=0;\n  function variantOf(r){ return r.p.variants.find(function(v){ return v.options.every(function(o,i){ return o===r.sel[i]; }); }); }\n\n  function parseLine(line){\n    var t=line.replace(/\\t/g,' ').trim(); if(!t) return null;\n    var qty=1, m;\n    if((m=t.match(/^(\\d{1,5})\\s*[x×]\\s+/i))){ qty=+m[1]; t=t.slice(m[0].length); }\n    else if((m=t.match(/(?:\\s|^)[x×]?\\s*(\\d{1,5})\\s*(?:[x×]|stk\\.?|st(?:ü|u)ck|pcs|pc)?\\s*$/i)) && !/(kg|g|ml|l|liter)\\s*$/i.test(t)){\n      qty=+m[1]; t=t.slice(0,m.index).trim(); }\n    var first=t.split(/[\\s;,]+/)[0], code=/^[a-z0-9]{2,}(-[a-z0-9]+){2,}$/i.test(first)?first:null;\n    var q=t.replace(/(\\d+(?:[.,]\\d+)?)\\s*(kg|g|ml|liters?|litres?|ltr|l)\\b/ig,' ')\n      .replace(/\\b(standard|premium|exklusiv\\w*|exclusive|qualit\\w*|quality)\\b/ig,' ').replace(/[;&|]/g,' ').replace(/\\s+/g,' ').trim();\n    return {raw:line.trim(), text:t, code:code, q:code||q, qty:Math.max(1,qty)};\n  }\n  function pick(p,text){\n    var ln=norm(text), sz=sizeOf(text), sel=[], exact=true;\n    p.options.forEach(function(o,i){\n      var vals=optVals(p,i), hit=null;\n      if(sz) hit=vals.find(function(v){ var s=sizeOf(v); return s&&s.n===sz.n&&s.u===sz.u; });\n      if(!hit) hit=vals.find(function(v){ var nv=norm(v); return nv.length>2&&ln.indexOf(nv)>-1; });\n      if(!hit) hit=vals.find(function(v){ var w=norm(String(v).split(/[\\s&\\/\\-]+/)[0]); return w.length>3&&ln.indexOf(w)>-1; });\n      if(!hit){ hit=vals[0]; if(vals.length>1) exact=false; }\n      sel[i]=hit;\n    });\n    return {sel:sel,exact:exact};\n  }\n  function resolve(info){\n    return suggest(info.q,info.code?5:3).then(function(list){\n      if(!list.length && info.code){ var alt=info.text.replace(info.code,'').replace(/(\\d+(?:[.,]\\d+)?)\\s*(kg|g|ml|l)\\b/ig,' ').trim(); if(alt.length>2) return suggest(alt,3); }\n      return list;\n    }).then(function(list){\n      var c=list.slice(0,info.code?5:1);\n      return Promise.all(c.map(function(x){ return product(x.handle).catch(function(){return null;}); })).then(function(ps){\n        ps=ps.filter(Boolean);\n        if(info.code){ var k=norm(info.code);\n          var hit=ps.find(function(p){ return p.variants.some(function(v){ return v.sku&&norm(v.sku)===k; }); })\n               ||ps.find(function(p){ return p.variants.some(function(v){ return v.sku&&norm(v.sku).indexOf(k)===0; }); });\n          if(hit) return hit; }\n        return ps[0]||null;\n      });\n    });\n  }\n  function addParsed(info){\n    var r={id:++uid,raw:info.raw,qty:info.qty,state:'loading'}; rows.push(r); render();\n    return resolve(info).then(function(p){\n      if(!p){ r.state='missing'; return; }\n      var k=pick(p,info.text); r.p=p; r.sel=k.sel; r.state=k.exact?'ok':'check';\n    }).catch(function(){ r.state='missing'; }).then(function(){ render(); save(); });\n  }\n  function addProduct(handle){\n    return product(handle).then(function(p){\n      var v=p.variants.find(function(x){return x.available;})||p.variants[0];\n      rows.push({id:++uid,p:p,sel:v.options.slice(),qty:1,state:'ok'}); render(); save();\n    });\n  }\n\n  /* kleine Warteschlange: max. 3 Anfragen gleichzeitig */\n  function runQueue(items){\n    var i=0, btn=$('fqo-parse'); btn.disabled=true;\n    function worker(){ if(i>=items.length) return Promise.resolve(); var it=items[i++]; return addParsed(it).then(worker); }\n    return Promise.all([worker(),worker(),worker()]).then(function(){ btn.disabled=false; });\n  }\n\n  /* ---------- Anzeige ---------- */\n  function render(){\n    var box=$('fqo-rows');\n    box.innerHTML=rows.map(function(r){\n      if(r.state==='loading') return '<div class=\"fqo-row\"><span></span><div><div class=\"fqo-name\">'+esc(r.raw)+'</div><div class=\"fqo-sku\">'+L.loading+'</div></div><span></span></div>';\n      if(r.state==='missing') return '<div class=\"fqo-row is-bad\" data-id=\"'+r.id+'\"><span></span><div><div class=\"fqo-name\">'+esc(r.raw)+'</div><div class=\"fqo-note\">'+L.notFound+'</div></div>'\n        +'<div class=\"fqo-right\"><button type=\"button\" class=\"fqo-x\" data-act=\"rm\" aria-label=\"'+L.remove+'\">✕</button></div></div>';\n      var p=r.p, v=variantOf(r), bad=!v||!v.available, cls=bad?' is-bad':(r.state==='check'?' is-check':'');\n      var opts=p.options.map(function(o,i){ var vals=optVals(p,i); if(vals.length<2&&vals[0]==='Default Title') return '';\n        return '<select data-act=\"opt\" data-i=\"'+i+'\" aria-label=\"'+esc(optName(p,i))+'\">'+vals.map(function(val){\n          return '<option'+(val===r.sel[i]?' selected':'')+'>'+esc(val)+'</option>'; }).join('')+'</select>'; }).join('');\n      var note=bad?L.soldout:(r.state==='check'?L.check:'');\n      var im=(v&&v.featured_image&&v.featured_image.src)||p.featured_image;\n      return '<div class=\"fqo-row'+cls+'\" data-id=\"'+r.id+'\">'+(im?'<img src=\"'+img(im,120)+'\" alt=\"\">':'<span></span>')\n        +'<div><div class=\"fqo-name\">'+esc(p.title)+'</div><div class=\"fqo-sku\">'+esc((v&&v.sku)||'')+'</div>'\n        +'<div class=\"fqo-opts\">'+opts+'<input type=\"number\" min=\"1\" value=\"'+r.qty+'\" data-act=\"qty\" aria-label=\"'+L.qty+'\"></div>'\n        +(note?'<div class=\"fqo-note\">'+note+'</div>':'')+'</div>'\n        +'<div class=\"fqo-right\"><span class=\"fqo-price\">'+(v?money.format(unitP(v)*r.qty/100):'–')+'</span>'\n        +'<button type=\"button\" class=\"fqo-x\" data-act=\"rm\" aria-label=\"'+L.remove+'\">✕</button></div></div>';\n    }).join('');\n    var ok=rows.filter(function(r){ var v=r.p&&variantOf(r); return v&&v.available; });\n    $('fqo-sum').textContent=ok.length?money.format(ok.reduce(function(a,r){return a+unitP(variantOf(r))*r.qty;},0)/100):'–';\n    $('fqo-foot').hidden=!rows.length;\n    $('fqo-add').disabled=!ok.length||rows.some(function(r){return r.state==='loading';});\n  }\n  function rowOf(el){ var d=el.closest('[data-id]'); return d&&rows.find(function(r){return r.id===+d.dataset.id;}); }\n  $('fqo-rows').addEventListener('change',function(e){ var r=rowOf(e.target); if(!r) return;\n    if(e.target.dataset.act==='opt'){ r.sel[+e.target.dataset.i]=e.target.value; r.state='ok'; }\n    if(e.target.dataset.act==='qty'){ r.qty=Math.max(1,parseInt(e.target.value,10)||1); }\n    render(); save(); });\n  $('fqo-rows').addEventListener('click',function(e){ if(e.target.dataset.act!=='rm') return; var r=rowOf(e.target);\n    rows=rows.filter(function(x){return x!==r;}); render(); save(); });\n\n  /* ---------- Einfügen & Suche ---------- */\n  $('fqo-parse').addEventListener('click',function(){\n    var items=$('fqo-text').value.split(/\\r?\\n/).map(parseLine).filter(Boolean);\n    if(!items.length) return; $('fqo-text').value=''; $('fqo-msg').textContent=''; runQueue(items);\n  });\n  var timer;\n  $('fqo-q').addEventListener('input',function(e){ clearTimeout(timer); var q=e.target.value.trim(), ul=$('fqo-results');\n    if(q.length<2){ ul.innerHTML=''; return; }\n    timer=setTimeout(function(){ suggest(q,8).then(function(list){\n      ul.innerHTML=list.length?list.map(function(p){ return '<li tabindex=\"0\" data-h=\"'+esc(p.handle)+'\">'+(p.image?'<img src=\"'+img(p.image,72)+'\" alt=\"\">':'')+'<span>'+esc(p.title)+'</span></li>'; }).join('')\n        :'<li>'+L.noHits+'</li>'; }); },250); });\n  function choose(e){ var li=e.target.closest('li[data-h]'); if(!li||(e.type==='keydown'&&e.key!=='Enter')) return;\n    $('fqo-results').innerHTML=''; $('fqo-q').value=''; addProduct(li.dataset.h); }\n  $('fqo-results').addEventListener('click',choose); $('fqo-results').addEventListener('keydown',choose);\n\n  /* ---------- Speichern auf dem Gerät ---------- */\n  function save(){ try{ localStorage.setItem(KEY,JSON.stringify(rows.filter(function(r){return r.p;}).map(function(r){ return {h:r.p.handle,s:r.sel,q:r.qty}; }))); }catch(e){} }\n  function restore(){ var list=[]; try{ list=JSON.parse(localStorage.getItem(KEY)||'[]'); }catch(e){}\n    list.forEach(function(x){ var r={id:++uid,raw:x.h,qty:x.q,state:'loading'}; rows.push(r);\n      product(x.h).then(function(p){ r.p=p; r.sel=x.s; r.state='ok'; }).catch(function(){ rows=rows.filter(function(y){return y!==r;}); }).then(render); });\n    render(); }\n  $('fqo-clear').addEventListener('click',function(){ rows=[]; save(); render(); });\n\n  /* ---------- Warenkorb ---------- */\n  $('fqo-add').addEventListener('click',function(){\n    var btn=this, todo=rows.filter(function(r){ var v=r.p&&variantOf(r); return v&&v.available; }), errs=[];\n    btn.disabled=true; btn.textContent=L.adding;\n    (function next(){\n      if(!todo.length){\n        if(!errs.length){ window.location.href=ROOT+'cart'; return; }\n        $('fqo-msg').innerHTML=L.cartErr+'<br>'+errs.map(esc).join('<br>')+'<br><a href=\"'+ROOT+'cart\">'+L.toCart+'</a>';\n        btn.textContent=L.addCart; render(); return; }\n      var r=todo.shift(), v=variantOf(r);\n      fetch(ROOT+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({items:(function(){ if(!isG(v)) return [{id:v.id,quantity:r.qty}]; var a=[],st=String(Date.now()); for(var k=0;k<r.qty;k++) a.push({id:v.id,quantity:6,properties:{_Flasche:st+'-'+k}}); return a; })()})})\n        .then(function(res){ return res.json().then(function(j){ if(!res.ok) throw new Error(j.description||j.message||res.status); }); })\n        .catch(function(e){ errs.push(r.qty+' × '+r.p.title+' ('+r.sel.join(' / ')+'): '+e.message); }).then(next);\n    })();\n  });\n\n  restore();\n})();\n</script>",
