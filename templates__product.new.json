        "custom_liquid_dCUjTL": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  Fragrance Hub Germany – Lieferinfo & Artikelnummer\n  Block \"Benutzerdefiniertes Liquid\" im Produkt-Template, direkt unter \"Preis\".\n  Ersetzt die Theme-Blöcke Lagerbestand und SKU (diese im Editor ausblenden)\n  sowie den Theme-Hinweis \"Versand wird beim Checkout berechnet\".\n{%- endcomment -%}\n{%- liquid\n  assign fv = product.selected_or_first_available_variant\n  assign txt_steuer = 'Nettopreis zzgl. MwSt. und Versand'\n  assign txt_ok = 'Frisch abgefüllt · Bestellung bis 12 Uhr, Versand am selben Werktag'\n  assign txt_off = 'Derzeit nicht verfügbar'\n  assign txt_liefer = 'Lieferung: Deutschland 1–2 Werktage · EU 1–3 Werktage'\n  assign txt_art = 'Art.-Nr.'\n  if request.locale.iso_code == 'en'\n    assign txt_steuer = 'Net price plus VAT and shipping'\n    assign txt_ok = 'Freshly filled · Order by 12 noon, ships the same working day'\n    assign txt_off = 'Currently unavailable'\n    assign txt_liefer = 'Delivery: Germany 1–2 working days · EU 1–3 working days'\n    assign txt_art = 'Item no.'\n  elsif request.locale.iso_code == 'ar'\n    assign txt_steuer = 'السعر صافٍ غير شامل ضريبة القيمة المضافة والشحن'\n    assign txt_ok = 'تعبئة طازجة · اطلب قبل الساعة 12 ظهراً ويُشحن طلبك في نفس يوم العمل'\n    assign txt_off = 'غير متوفر حالياً'\n    assign txt_liefer = 'التوصيل: ألمانيا 1–2 يوم عمل · الاتحاد الأوروبي 1–3 أيام عمل'\n    assign txt_art = 'رقم الصنف'\n  endif\n-%}\n<div class=\"fh-li\" id=\"fh-li-{{ section.id }}\">\n<style>\n.fh-li{display:flex;flex-direction:column;gap:5px;margin:6px 0 16px;font-size:1.35rem;line-height:1.5;color:#5b5a57;text-align:start}\n.fh-li-row{display:flex;align-items:center;gap:8px}\n.fh-li-dot{flex:0 0 8px;width:8px;height:8px;border-radius:50%;background:#3aa76d}\n.fh-li-dot.is-off{background:#c9ccd8}\n.fh-li-main{color:#1c2135}\n.fh-li-sub{padding-inline-start:16px;font-size:1.25rem}\n.fh-li-sku{padding-inline-start:16px;font-size:1.2rem;letter-spacing:.04em;color:#8a8983}\n.fh-li-sku[hidden]{display:none}\n.fh-li-tax{font-size:1.25rem;color:#8a8983;margin-bottom:6px}\n#MainProduct-{{ section.id }} .product__tax{display:none}\n</style>\n  <div class=\"fh-li-tax\">{{ txt_steuer }}</div>\n  <div class=\"fh-li-row\">\n    <span class=\"fh-li-dot{% unless fv.available %} is-off{% endunless %}\" aria-hidden=\"true\"></span>\n    <span class=\"fh-li-main\">{% if fv.available %}{{ txt_ok }}{% else %}{{ txt_off }}{% endif %}</span>\n  </div>\n  <div class=\"fh-li-sub\">{{ txt_liefer }}</div>\n  <div class=\"fh-li-sku\"{% if fv.sku == blank %} hidden{% endif %}>{{ txt_art }} <span dir=\"ltr\">{{ fv.sku | split: '-SH-' | first }}{% if fv.sku contains '-SH-' %}-SH{% endif %}</span></div>\n</div>\n<script type=\"application/json\" id=\"fh-li-data-{{ section.id }}\">\n{\"opts\":{{ product.options | json }},\"ok\":{{ txt_ok | json }},\"off\":{{ txt_off | json }},\"v\":[\n{%- for v in product.variants -%}{\"id\":{{ v.id }},\"o\":{{ v.options | json }},\"s\":{{ v.sku | default: '' | json }},\"a\":{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]}\n</script>\n<script>\n(function () {\n  var SID = {{ section.id | json }};\n  var box = document.getElementById('fh-li-' + SID);\n  var dataEl = document.getElementById('fh-li-data-' + SID);\n  if (!box || !dataEl) return;\n  var D = JSON.parse(dataEl.textContent);\n  var root = box.closest('product-info') || box.closest('.shopify-section') || document;\n\n  function norm(s) { return (s || '').toString().trim().toLowerCase(); }\n  function optionValue(name) {\n    var n = norm(name), fs = root.querySelectorAll('fieldset');\n    for (var i = 0; i < fs.length; i++) {\n      var lg = fs[i].querySelector('legend');\n      if (lg && norm(lg.textContent).indexOf(n) === 0) {\n        var c = fs[i].querySelector('input[type=radio]:checked');\n        if (c) return c.value;\n      }\n    }\n    var sel = root.querySelector('select[name=\"options[' + name + ']\"]');\n    return sel ? sel.value : null;\n  }\n  function currentVariant() {\n    var vals = D.opts.map(optionValue);\n    if (vals.every(function (x) { return x !== null; })) {\n      for (var i = 0; i < D.v.length; i++) {\n        if (D.v[i].o.every(function (x, k) { return x === vals[k]; })) return D.v[i];\n      }\n    }\n    var idIn = document.querySelector('#product-form-' + SID + ' input[name=\"id\"]');\n    if (idIn) {\n      for (var j = 0; j < D.v.length; j++) if (String(D.v[j].id) === idIn.value) return D.v[j];\n    }\n    return null;\n  }\n  function update() {\n    var v = currentVariant();\n    if (!v) return;\n    box.querySelector('.fh-li-dot').classList.toggle('is-off', !v.a);\n    box.querySelector('.fh-li-main').textContent = v.a ? D.ok : D.off;\n    var sku = box.querySelector('.fh-li-sku');\n    sku.hidden = !v.s;\n    sku.querySelector('span').textContent = (v.s.indexOf('-SH-') > -1 ? v.s.slice(0, v.s.indexOf('-SH-') + 3) : v.s);\n  }\n  root.addEventListener('change', function () {\n    update(); setTimeout(update, 350); setTimeout(update, 900);\n  });\n})();\n</script>"
