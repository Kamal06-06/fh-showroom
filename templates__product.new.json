22) 0)}\n</style>\n<script>\n(function () {\n  /* ================= VORLAGEN – hier anpassen ================= */\n  var LG = (document.documentElement.lang || 'de').slice(0, 2);\n  var GROESSEN = ({        /* Gramm : Etikett über der Größe */\n    de: { 6: 'Zum Testen', 100: 'Einstieg', 250: 'Beliebt', 500: 'Vorteilsgröße', 1000: 'Großhandel', 5000: 'Großabnehmer' },\n    en: { 6: 'Try first', 100: 'Starter', 250: 'Popular', 500: 'Best value', 1000: 'Wholesale', 5000: 'Bulk buyer' },\n    ar: { 6: 'للتجربة', 100: 'للبداية', 250: 'الأكثر طلباً', 500: 'الأوفر', 1000: 'جملة', 5000: 'كميات كبيرة' }\n  })[LG] || {};\n  var SKALEN = ({ de: ['Intensität', 'Haltbarkeit'], en: ['Intensity', 'Longevity'], ar: ['الشدة', 'الثبات'] })[LG] || ['Intensität', 'Haltbarkeit'];\n  var TXT = {\n    de: { standard: 'Solide Qualität für eigene Parfümkreationen und Mischungen – ideal für Einsteiger und größere Mengen.',\n          premium: 'Höhere Konzentration mit spürbar mehr Ausstrahlung und Haltbarkeit – für anspruchsvolle Parfümkreationen.',\n          exklusiv: 'Unsere Spitzenqualität: höchste Konzentration, starke Projektion und besonders lange Haltbarkeit.' },\n    en: { standard: 'Solid quality for your own perfume creations and blends – ideal for beginners and larger quantities.',\n          premium: 'Higher concentration with noticeably more projection and longevity – for demanding perfume creations.',\n          exklusiv: 'Our top quality: highest concentration, strong projection and exceptionally long longevity.' },\n    ar: { standard: 'جودة متينة لتركيباتك العطرية وخلطاتك الخاصة – مثالية للمبتدئين وللكميات الكبيرة.',\n          premium: 'تركيز أعلى مع فوحان وثبات أكبر بشكل ملحوظ – للتركيبات العطرية الراقية.',\n          exklusiv: 'أعلى جودة لدينا: أعلى تركيز، فوحان قوي وثبات طويل جداً.' }\n  };\n  var TQ = TXT[LG] || TXT.de;\n  var QUALITAET = {       /* werte = 1 bis 5 Balken je Skala */\n    standard: { text: TQ.standard, werte: [3, 3] },\n    premium:  { text: TQ.premiu