lector('input[type=radio]')) return fs[i];\n    }\n    return null;\n  }\n  function checkedValue(fs) {\n    var c = fs && fs.querySelector('input[type=radio]:checked');\n    return c ? c.value : null;\n  }\n  function variantFor(sizeVal, qualVal) {\n    for (var i = 0; i < D.v.length; i++) {\n      var o = D.v[i].o;\n      if (o[sizeIdx] === sizeVal && (qualIdx < 0 || !qualVal || o[qualIdx] === qualVal)) return D.v[i];\n    }\n    return null;\n  }\n  function labelFor(fs, inp) {\n    return (inp.id && fs.querySelector('label[for=\"' + CSS.escape(inp.id) + '\"]')) || inp.nextElementSibling;\n  }\n  function wrapMain(lb) {\n    if (lb.querySelector('.fh-vp-main')) return;\n    for (var n = lb.firstChild; n; n = n.nextSibling) {\n      if (n.nodeType === 3 && n.textContent.trim()) {\n        var s = document.createElement('span');\n        s.className = 'fh-vp-main';\n        lb.insertBefore(s, n);\n        s.appendChild(n);\n        return;\n      }\n    }\n  }\n  function setPart(lb, cls, text) {\n    var el = lb.querySelector('.' + cls);\n    if (!text) { if (el) el.remove(); return; }\n    if (!el) { el = document.createElement('span'); el.className = cls; lb.appendChild(el); }\n    if (el.textContent !== text) el.textContent = text;\n  }\n\n  function enhanceSizes() {\n    var fs = findFieldset(sizeIdx);\n    if (!fs) return;\n    fs.classList.add('fh-vp', 'fh-vp-size');\n    var q = checkedValue(findFieldset(qualIdx));\n    var inputs = fs.querySelectorAll('input[type=radio]');\n    var ref = 0, refG = Infinity;\n    inputs.forEach(function (inp) {\n      var g = grams(inp.value), v = variantFor(inp.value, q);\n      if (v && g >= 50 && g < refG) { refG = g; ref = v.p / g; }\n    });\n    inputs.forEach(function (inp) {\n      var lb = labelFor(fs, inp);\n      if (!lb) return;\n      wrapMain(lb);\n      var g = grams(inp.value), v = variantFor(inp.value, q);\n      setPart(lb, 'fh-vp-badge', GROESSEN[g] || '');\n      var isG = /pro\\s*gramm|per\\s*gram|بالغرام/i.test(inp.value);\n      if (isG) { var mm = lb.querySelector('.fh-vp-main'); var nm = LG === 'en' ? 'Sample 6–15 g' : LG === 'ar' ? 'عينة 6–15 غ' : 'Probe 6–15 g'; if (mm && mm.textContent !== nm) mm.textContent = nm; }\n      setPart(lb, 'fh-vp-price', v ? (isG ? (LG === 'en' ? 'from ' : LG === 'ar' ? 'من ' : 'ab ') : '') + fmt.format((isG ? v.p * 6 : v.p) / 100) : '');\n      var kg = '', save = '';\n      if (v && g >= 50) {\n        kg = fmt.format(v.p / g * 10) + '/kg';\n        if (ref) {\n          var pct = Math.round((1 - (v.p / g) / ref) * 100);\n          if (pct >= 5) save = '−' + pct + ' %';\n        }\n      }\n      if (isG && v) kg = '+ ' + fmt.format(v.p / 100) + (LG === 'en' ? ' per extra g' : LG === 'ar' ? ' لكل غرام إضافي' : ' je weiteres g');\n      setPart(lb, 'fh-vp-kg', kg);\n      setPart(lb, 'fh-vp-save', save);\n    });\n  }\n\n  function enhanceQuality() {\n    var fs = findFieldset(qualIdx);\n    if (!fs) return;\n    fs.classList.add('fh-vp', 'fh-vp-qual');\n    fs.querySelectorAll('input[type=radio]').forEach(function (inp) {\n      var lb = labelFor(fs, inp);\n      if (!lb) return;\n      wrapMain(lb);\n      var Q = QUALITAET[qualKey(inp.value)];\n      setPart(lb, 'fh-vp-desc', Q ? Q.text : '');\n      var m = lb.querySelector('.fh-vp-meters');\n      if (Q && !m) {\n        m = document.createElement('span');\n        m.className = 'fh-vp-meters';\n        m.innerHTML = SKALEN.map(function (s, i) {\n          return '<span class=\"fh-vp-m\">' + s + '<span class=\"fh-vp-bar\" style=\"--v:' + (Q.werte[i] || 0) + '\"></span></span>';\n        }).join('');\n        lb.appendChild(m);\n      } else if (!Q && m) { m.remove(); }\n    });\n  }\n\n  var timer, obs = new MutationObserver(function () { clearTimeout(timer); timer = setTimeout(run, 30); });\n  function run() {\n    obs.disconnect();\n    try { enhanceSizes(); enhanceQuality(); }\n    finally { obs.observe(root, { childList: true, subtree: true }); }\n  }\n  root.addEventListener('change', function () { setTimeout(run, 0); });\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run); else run();\n})();\n</script>"
