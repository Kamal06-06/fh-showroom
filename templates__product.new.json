          "settings": {
            "custom_liquid": "{% if product.tags contains 'Freie Auswahl' %}\n<div class=\"fh-set\" data-form=\"product-form-{{ section.id }}\">\n  <p class=\"fh-set__title\">{% if request.locale.iso_code == 'en' %}Choose your fragrances{% elsif request.locale.iso_code == 'ar' %}اختر عطورك{% else %}Ihre Düfte auswählen{% endif %}</p>\n  <p class=\"fh-set__hint\">{% if request.locale.iso_code == 'en' %}Type at least 2 letters or the article code, then tap the fragrance in the list. Only fragrances from our range can be selected.{% elsif request.locale.iso_code == 'ar' %}اكتب حرفين على الأقل أو رمز المنتج، ثم اضغط على العطر من القائمة. يمكن اختيار عطور من تشكيلتنا فقط.{% else %}Mindestens 2 Buchstaben oder den Artikelcode eingeben, dann den Duft aus der Liste antippen. Es sind nur Düfte aus unserem Sortiment möglich.{% endif %}</p>\n  <div class=\"fh-set__fields\"></div>\n</div>\n<style>\n  .fh-set{margin:1.5rem 0;padding:1.2rem;border:1px solid rgba(var(--color-foreground),.15);border-radius:8px}\n  .fh-set__title{margin:0 0 .3rem;font-weight:600;font-size:1.6rem}\n  .fh-set__hint{margin:0 0 1rem;font-size:1.3rem;opacity:.75}\n  .fh-set__row{position:relative;display:flex;align-items:center;gap:.8rem;margin-bottom:.6rem}\n  .fh-set__row label{min-width:5.5rem;font-size:1.3rem}\n  .fh-set__row input{flex:1;padding:.9rem 1rem;font-size:1.5rem;border:1px solid rgba(var(--color-foreground),.3);border-radius:6px;background:rgb(var(--color-background));color:rgb(var(--color-foreground))}\n  .fh-set__row input.ok{border-color:#2e7d32}\n  .fh-set__list{position:absolute;z-index:20;top:100%;inset-inline-start:6.3rem;inset-inline-end:0;margin:0;padding:0;list-style:none;background:rgb(var(--color-background));border:1px solid rgba(var(--color-foreground),.2);border-radius:6px;max-height:24rem;overflow-y:auto}\n  .fh-set__list:empty{display:none}\n  .fh-set__list li{padding:.9rem 1rem;font-size:1.4rem;cursor:pointer}\n  .fh-set__list li:hover{background:rgba(var(--color-foreground),.06)}\n  .fh-set__list li.none{cursor:default;opacity:.7}\n  .product-form .shopify-payment-button{display:none}\n</style>\n<script>\n(function(){\n  var box = document.querySelector('.fh-set'); if (!box) return;\n  var formId = box.dataset.form;\n  var wrap = box.querySelector('.fh-set__fields');\n  var sizes = { {% for v in product.variants %}\"{{ v.id }}\": {{ v.title | slice: 0, 2 | strip | plus: 0 }}{% unless forloop.last %},{% endunless %}{% endfor %} };\n  var searchUrl = '{{ routes.predictive_search_url }}.json';\n  var T = {% if request.locale.iso_code == 'en' %}{lbl:'Fragrance',ph:'Fragrance name or article code',pick:'Please choose a fragrance from the list.',none:'No fragrance found'}{% elsif request.locale.iso_code == 'ar' %}{lbl:'العطر',ph:'اسم العطر أو رمز المنتج',pick:'يرجى اختيار عطر من القائمة.',none:'لم يُعثر على عطر'}{% else %}{lbl:'Duft',ph:'Duftname oder Artikelcode',pick:'Bitte einen Duft aus der Liste wählen.',none:'Kein Duft gefunden'}{% endif %};\n\n  for (var i = 1; i <= 20; i++) {\n    var row = document.createElement('div');\n    row.className = 'fh-set__row';\n    row.innerHTML = '<label>' + T.lbl + ' ' + i + '</label>' +\n      '<input type=\"text\" autocomplete=\"off\" name=\"properties[Duft ' + i + ']\" form=\"' + formId + '\" placeholder=\"' + T.ph + '\">' +\n      '<ul class=\"fh-set__list\"></ul>';\n    wrap.appendChild(row);\n  }\n  var rows = [].slice.call(wrap.children);\n\n  function count() {\n    var f = document.getElementById(formId);\n    var id = f && f.querySelector('[name=\"id\"]');\n    return (id && sizes[id.value]) || 5;\n  }\n  /* Nur Düfte, die aus der Liste gewählt wurden (exakt der Shop-Name) – freier Text wird abgelehnt */\n  function check(inp) {\n    var v = inp.value.trim();\n    var ok = v !== '' && inp.dataset.ok === v;\n    inp.setCustomValidity(ok ? '' : T.pick);\n    inp.classList.toggle('ok', ok);\n    return ok;\n  }\n  function update() {\n    var n = count();\n    rows.forEach(function(r, i){\n      var on = i < n, inp = r.querySelector('input');\n      r.style.display = on ? '' : 'none';\n      inp.disabled = !on;\n      inp.required = on;\n    });\n  }\n  document.addEventListener('change', function(){ setTimeout(update, 60); });\n  update();\n\n  rows.forEach(function(r){\n    var inp = r.querySelector('input'), list = r.querySelector('ul'), t;\n    inp.addEventListener('input', function(){\n      inp.classList.remove('ok');\n      inp.setCustomValidity(T.pick);\n      clearTimeout(t);\n      var q = inp.value.trim();\n      if (q.length < 2) { list.innerHTML = ''; return; }\n      t = setTimeout(function(){\n        fetch(searchUrl + '?q=' + encodeURIComponent(q) +\n          '&resources[type]=product&resources[limit]=10&resources[options][fields]=title,variants.sku')\n          .then(function(res){ return res.json(); })\n          .then(function(d){\n            var p = ((d.resources && d.resources.results && d.resources.results.products) || [])\n              .filter(function(x){ return x.type === 'Fragrance Oil'; });\n            list.innerHTML = p.length\n              ? p.map(function(x){\n                  var s = x.title.replace(/&/g,'&amp;').replace(/\"/g,'&quot;').replace(/</g,'&lt;');\n                  return '<li data-v=\"' + s + '\">' + s + '</li>';\n                }).join('')\n              : '<li class=\"none\">' + T.none + '</li>';\n          })\n          .catch(function(){ list.innerHTML = ''; });\n      }, 250);\n    });\n    list.addEventListener('pointerdown', function(e){\n      var li = e.target.closest('li[data-v]'); if (!li) return;\n      e.preventDefault();\n      inp.value = li.textContent;\n      inp.dataset.ok = li.textContent;\n      inp.setCustomValidity('');\n      inp.classList.add('ok');\n      list.innerHTML = '';\n    });\n    inp.addEventListener('blur', function(){ setTimeout(function(){ list.innerHTML = ''; }, 200); check(inp); });\n  });\n\n  document.addEventListener('submit', function(e){\n    if (!e.target || e.target.id !== formId) return;\n    var bad = rows.filter(function(r){\n      var i = r.querySelector('input');\n      if (i.disabled) return false;\n      check(i);\n      return !i.checkValidity();\n    })[0];\n    if (bad) {\n      e.preventDefault();\n      e.stopPropagation();\n      bad.querySelector('input').reportValidity();\n    }\n  }, true);\n})();\n</script>\n{% endif %}"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "custom_liquid_eyCrLQ": {
          "type": "custom_liquid",
          "name": "versand heute",
          "settings": {
            "custom_liquid": "{%- liquid\n  assign en = false\n  if request.locale.iso_code == 'en'\n    assign en = true\n  endif\n  assign ar = false\n  if request.locale.iso_code == 'ar'\n    assign ar = true\n  endif\n-%}\n{%- comment -%}\n VERSAND-COUNTDOWN – Produktseite (Block \"Benutzerdefiniertes Liquid\" unter dem Kaufen-Button)\n Versand Mo–Fr, Bestellschluss 12:00 Uhr (deutsche Zeit), Feiertage NRW werden übersprungen.\n{%- endcomment -%}\n<div class=\"fhcd\" id=\"fhcd-{{ block.id | default: section.id }}\" dir=\"{% if ar %}rtl{% else %}ltr{% endif %}\" hidden>\n  <svg class=\"fhcd__icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 7h11v9H3zM14 10h4l3 3v3h-7z\"/><circle cx=\"7\" cy=\"17.5\" r=\"1.6\"/><circle cx=\"17\" cy=\"17.5\" r=\"1.6\"/></svg>\n  <p class=\"fhcd__text\" aria-live=\"polite\"></p>\n</div>\n\n<style>\n  .fhcd{display:flex;align-items:center;gap:1.2rem;margin:1.4rem 0;padding:1.2rem 1.4rem;\n    border:1px solid #E7E1D3;border-left:3px solid #B8963E;border-radius:4px;background:#FAF8F3;text-align:start}\n  .fhcd[dir=rtl]{border-left:1px solid #E7E1D3;border-right:3px solid #B8963E}\n  .fhcd[hidden]{display:none}\n  .fhcd__icon{flex:0 0 24px;width:24px;height:24px;fill:none;stroke:#B8963E;stroke-width:1.6;stroke-linejoin:round;stroke-linecap:round}\n  .fhcd__text{margin:0;font-size:1.4rem;line-height:1.45;color:#262B3B}\n  .fhcd__text strong{font-weight:700;color:#262B3B}\n  .fhcd__time{font-weight:700;color:#9C7D30;font-variant-numeric:tabular-nums}\n</style>\n\n<script>\n(function(){\n  var box = document.getElementById('fhcd-{{ block.id | default: section.id }}');\n  if (!box) return;\n  var txt = box.querySelector('.fhcd__text');\n  var EN = {{ en | json }};\n  var AR = {{ ar | json }};\n  var CUTOFF = 12; // Uhr\n\n  function berlinNow(){\n    var p = {};\n    new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Berlin',year:'numeric',month:'2-digit',day:'2-digit',\n      hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'}).formatToParts(new Date())\n      .forEach(function(x){ p[x.type] = x.value; });\n    return {y:+p.year, m:+p.month, d:+p.day, h:+p.hour, min:+p.minute, s:+p.second};\n  }\n  function key(dt){ return dt.toISOString().slice(0,10); }\n  function addDays(dt,n){ var c = new Date(dt); c.setUTCDate(c.getUTCDate()+n); return c; }\n  function easter(y){\n    var a=y%19,b=Math.floor(y/100),c=y%100,d=Math.floor(b/4),e=b%4,f=Math.floor((b+8)/25),g=Math.floor((b-f+1)/3),\n        h=(19*a+b-d-g+15)%30,i=Math.floor(c/4),k=c%4,l=(32+2*e+2*i-h-k)%7,m=Math.floor((a+11*h+22*l)/451),\n        mo=Math.floor((h+l-7*m+114)/31),da=((h+l-7*m+114)%31)+1;\n    return new Date(Date.UTC(y,mo-1,da));\n  }\n  var cache = {};\n  function holidays(y){\n    if (cache[y]) return cache[y];\n    var e = easter(y), s = {};\n    ['01-01','05-01','10-03','11-01','12-25','12-26'].forEach(function(md){ s[y+'-'+md] = 1; });\n    [-2,1,39,50,60].forEach(function(n){ s[key(addDays(e,n))] = 1; }); // Karfreitag, Ostermontag, Himmelfahrt, Pfingstmontag, Fronleichnam\n    return cache[y] = s;\n  }\n  function isWorkday(dt){\n    var wd = dt.getUTCDay();\n    return wd !== 0 && wd !== 6 && !holidays(dt.getUTCFullYear())[key(dt)];\n  }\n\n  var DAYS = EN ? ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday']\n           : AR ? ['الأحد','الاثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت']\n                : ['Sonntag','Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag'];\n\n  function render(){\n    var n = berlinNow();\n    var today = new Date(Date.UTC(n.y, n.m-1, n.d));\n    if (isWorkday(today) && n.h < CUTOFF) {\n      var left = (CUTOFF*3600) - (n.h*3600 + n.min*60 + n.s);\n      var hh = Math.floor(left/3600), mm = Math.ceil((left%3600)/60);\n      if (mm === 60) { hh += 1; mm = 0; }\n      var t = (hh > 0 ? hh + (EN ? ' h ' : AR ? ' س ' : ' Std. ') : '') + mm + (EN ? ' min' : AR ? ' د' : ' Min.');\n      txt.innerHTML = AR\n        ? 'اطلب خلال <span class=\"fhcd__time\">' + t + '</span> – يُشحن <strong>اليوم</strong>'\n        : EN\n        ? 'Order within <span class=\"fhcd__time\">' + t + '</span> – ships <strong>today</strong>'\n        : 'Bestellen Sie in <span class=\"fhcd__time\">' + t + '</span> – Versand <strong>noch heute</strong>';\n    } else {\n      var next = addDays(today, 1);\n      while (!isWorkday(next)) next = addDays(next, 1);\n      var diff = Math.round((next - today) / 86400000);\n      var when;\n      if (diff === 1) when = EN ? 'tomorrow' : AR ? 'غداً' : 'morgen';\n      else if (diff <= 6) when = (EN ? 'on ' : AR ? 'يوم ' : 'am ') + DAYS[next.getUTCDay()];\n      else when = (EN ? 'on ' : AR ? 'يوم ' : 'am ') + DAYS[next.getUTCDay()] + ', ' + ('0'+next.getUTCDate()).slice(-2) + '.' + ('0'+(next.getUTCMonth()+1)).slice(-2) + '.';\n      txt.innerHTML = AR\n        ? 'اطلب الآن – يُشحن <strong>' + when + '</strong>'\n        : EN\n        ? 'Order now – ships <strong>' + when + '</strong>'\n        : 'Jetzt bestellen – Versand <strong>' + when + '</strong>';\n    }\n    box.hidden = false;\n  }\n  render();\n  setInterval(render, 30000);\n})();\n</script>"
          }
        },
        "custom_liquid_QXxTrJ": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- if product.options contains 'Inhalt' -%}\n<a href=\"{{ routes.root_url | append: '/pages/parfum-rechner?oil=' | replace: '//', '/' }}{{ product.handle }}\"\n   style=\"display:flex;align-items:center;justify-content:center;gap:.5rem;margin:.6rem 0;padding:.8rem 1rem;border:1.5px solid #b3791c;border-radius:8px;color:#1d2b3a;text-decoration:none;font-weight:600\">\n  🧪 {% if request.locale.iso_code == 'de' %}Menge für meine Flakons berechnen{% elsif request.locale.iso_code == 'ar' %}احسب الكمية لعبواتي{% else %}Calculate amount for my bottles{% endif %}\n</a>\n{%- endif -%}"
          }
        },
        "custom_liquid_TaHLrc": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- assign fh_lg = request.locale.iso_code -%}\n{%- comment -%}\n  Fragrance Hub Germany – Duftprofil, Technische Daten & Muster\n  Block \"Benutzerdefiniertes Liquid\" im Produkt-Template (unter \"Beschreibung\")\n  Daten: product.metafields.custom.duftprofil (Duftpyramide)\n         product.metafields.custom.techdaten   (Technische Daten – folgt im nächsten Schritt)\n         variant.metafields.custom.ifra        (IFRA-Werte je Variante)\n{%- endcomment -%}\n{%- liquid\n  assign dp = product.metafields.custom.duftprofil.value\n  assign td = product.metafields.custom.techdaten.value\n\n  assign kmin = nil\n  assign kmax = nil\n  for var in product.variants\n    assign k = var.metafields.custom.ifra.value['4']\n    if k != blank\n      if kmin == nil or k < kmin\n        assign kmin = k\n      endif\n      if kmax == nil or k > kmax\n        assign kmax = k\n      endif\n    endif\n  endfor\n\n  assign muster = nil\n  for var in product.variants\n    assign t = var.title | downcase | remove: ' '\n    if var.available\n      if t contains '6g' or t contains 'probe'\n        assign muster = var\n        break\n      endif\n    endif\n  endfor\n-%}\n{%- if dp or kmin or td -%}\n<div class=\"fh\" dir=\"{% if fh_lg == 'ar' %}rtl{% else %}ltr{% endif %}\">\n<style>\n.fh{--fh-gold:#a8823e;--fh-gold-d:#8a6a2f;--fh-navy:#1c2135;--fh-line:#e6dcc6;--fh-soft:#f6f0e3;color:var(--fh-navy);font-family:var(--font-body-family);display:flex;flex-direction:column;gap:22px;margin:28px 0;text-align:start}\n.fh-serif{font-family:var(--font-heading-family)}\n.fh-card{background:#fff;border:1px solid var(--fh-line);border-radius:16px;padding:28px 30px;display:flex;flex-direction:column;gap:20px}\n.fh-head{display:flex;align-items:baseline;justify-content:space-between;gap:6px 14px;flex-wrap:wrap}\n.fh-h{font-size:2.6rem;font-weight:600;margin:0;line-height:1.2}\n.fh-sub{font-style:italic;color:var(--fh-gold-d);font-size:1.6rem}\n.fh-tags{display:flex;gap:8px;flex-wrap:wrap}\n.fh-tag{padding:5px 13px;border:1px solid var(--fh-gold);border-radius:999px;font-size:1.3rem}\n.fh-row{display:grid;grid-template-columns:48px minmax(0,1fr);gap:16px;align-items:start;padding-bottom:18px;border-bottom:1px solid #eee6d4}\n.fh-row:last-child{border-bottom:0;padding-bottom:0}\n.fh-lbl{font-size:1.2rem;font-weight:500;letter-spacing:.2em;color:var(--fh-gold-d);text-transform:uppercase}\n.fh-lbl-s{font-style:italic;color:#5b5a57;font-size:1.5rem;margin-inline-start:10px}\n.fh-pills{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}\n.fh-pill{padding:5px 12px;background:var(--fh-soft);border-radius:8px;font-size:1.4rem}\n.fh-hl{background:var(--fh-navy);border-radius:12px;padding:18px 22px;display:flex;align-items:center;justify-content:space-between;gap:10px 14px;flex-wrap:wrap}\n.fh-hl-l{font-size:1.2rem;letter-spacing:.15em;color:#d9c08a;text-transform:uppercase}\n.fh-hl-s{font-size:1.3rem;color:#c9ccd8;margin-top:4px}\n.fh-hl-v{font-size:3.4rem;font-weight:600;color:#fff;line-height:1}\n.fh-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:24px}\n.fh-kv{display:flex;justify-content:space-between;gap:12px;padding:11px 0;border-bottom:1px solid #eee6d4;font-size:1.4rem}\n.fh-kv span:first-child{color:#5b5a57}\n.fh-kv span:last-child{font-weight:500;text-align:end}\n.fh-hz{display:flex;align-items:center;gap:14px;flex-wrap:wrap;font-size:1.3rem;line-height:1.5;color:#3a3b45}\n.fh-hz img{width:40px;height:40px}\n.fh-trust{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;font-size:1.3rem;color:#3a3b45}\n.fh-trust div{display:flex;align-items:center;gap:10px}\n.fh-cta{border:1px solid var(--fh-gold);border-radius:16px;padding:22px 26px;display:flex;align-items:center;justify-content:space-between;gap:18px}\n.fh-cta p{margin:6px 0 0;font-size:1.4rem;line-height:1.6;color:#3a3b45}\n.fh-btn{flex-shrink:0;display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;background:var(--fh-navy);border-radius:10px;color:#e3c98f;font-size:1.5rem;font-weight:500;text-decoration:none}\n.fh-btn:hover{color:#fff}\n@media (max-width:749px){.fh-card{padding:22px 18px}.fh-grid,.fh-trust{grid-template-columns:1fr}.fh-cta{flex-direction:column;align-items:stretch}}\n</style>\n\n{%- if dp -%}\n<div class=\"fh-card\">\n  <div class=\"fh-head\"><h3 class=\"fh-h fh-serif\">{% if fh_lg == 'en' %}The fragrance pyramid{% elsif fh_lg == 'ar' %}الهرم العطري{% else %}Die Duftpyramide{% endif %}</h3><span class=\"fh-sub fh-serif\">{% if fh_lg == 'en' %}from top to base{% elsif fh_lg == 'ar' %}من القمة إلى القاعدة{% else %}von oben nach unten{% endif %}</span></div>\n  {%- if dp.geschlecht != blank or dp.familien.size > 0 -%}\n  <div class=\"fh-tags\">\n    {%- if dp.geschlecht != blank -%}<span class=\"fh-tag\">{{ dp.geschlecht }}</span>{%- endif -%}\n    {%- for f in dp.familien -%}<span class=\"fh-tag\">{{ f }}</span>{%- endfor -%}\n  </div>\n  {%- endif -%}\n  {%- assign stufen = 'kopf,herz,basis' | split: ',' -%}\n  {%- for s in stufen -%}\n    {%- assign noten = dp[s] -%}\n    {%- if noten.size > 0 -%}\n    <div class=\"fh-row\">\n      <svg width=\"44\" height=\"42\" viewBox=\"0 0 46 44\" fill=\"none\" stroke=\"#a8823e\" stroke-width=\"1.5\" stroke-linejoin=\"round\" aria-hidden=\"true\">\n        <polygon points=\"23,3 30,15 16,15\"{% if s == 'kopf' %} fill=\"#a8823e\"{% endif %}></polygon>\n        <polygon points=\"14.5,18 31.5,18 37.5,28 8.5,28\"{% if s == 'herz' %} fill=\"#a8823e\"{% endif %}></polygon>\n        <polygon points=\"7,31 39,31 44,41 2,41\"{% if s == 'basis' %} fill=\"#a8823e\"{% endif %}></polygon>\n      </svg>\n      <div>\n        {%- case s -%}\n          {%- when 'kopf' -%}<span class=\"fh-lbl\">{% if fh_lg == 'en' %}Top note{% elsif fh_lg == 'ar' %}النوتة العليا{% else %}Kopfnote{% endif %}</span><span class=\"fh-lbl-s fh-serif\">{% if fh_lg == 'en' %}The first impression{% elsif fh_lg == 'ar' %}الانطباع الأول{% else %}Der erste Eindruck{% endif %}</span>\n          {%- when 'herz' -%}<span class=\"fh-lbl\">{% if fh_lg == 'en' %}Heart note{% elsif fh_lg == 'ar' %}نوتة القلب{% else %}Herznote{% endif %}</span><span class=\"fh-lbl-s fh-serif\">{% if fh_lg == 'en' %}The character{% elsif fh_lg == 'ar' %}الطابع{% else %}Der Charakter{% endif %}</span>\n          {%- else -%}<span class=\"fh-lbl\">{% if fh_lg == 'en' %}Base note{% elsif fh_lg == 'ar' %}النوتة الأساسية{% else %}Basisnote{% endif %}</span><span class=\"fh-lbl-s fh-serif\">{% if fh_lg == 'en' %}The foundation{% elsif fh_lg == 'ar' %}الأساس{% else %}Das Fundament{% endif %}</span>\n        {%- endcase -%}\n        <div class=\"fh-pills\">{%- for n in noten -%}<span class=\"fh-pill\">{{ n }}</span>{%- endfor -%}</div>\n      </div>\n    </div>\n    {%- endif -%}\n  {%- endfor -%}\n</div>\n{%- endif -%}\n\n{%- if kmin or td -%}\n<div class=\"fh-card\">\n  <div class=\"fh-head\"><h3 class=\"fh-h fh-serif\">{% if fh_lg == 'en' %}Technical data &amp; safety{% elsif fh_lg == 'ar' %}البيانات الفنية والسلامة{% else %}Technische Daten &amp; Sicherheit{% endif %}</h3><span class=\"fh-sub fh-serif\">{% if fh_lg == 'en' %}according to SDS &amp; IFRA{% elsif fh_lg == 'ar' %}وفق صحيفة السلامة و IFRA{% else %}laut SDB &amp; IFRA{% endif %}</span></div>\n  {%- if kmin -%}\n  <div class=\"fh-hl\">\n    <div>\n      <div class=\"fh-hl-l\">{% if fh_lg == 'en' %}Max. use in fine fragrance{% elsif fh_lg == 'ar' %}أقصى نسبة في العطور الفاخرة{% else %}Max. Einsatz in Feinparfüm{% endif %}</div>\n      <div class=\"fh-hl-s\">{% if fh_lg == 'en' %}IFRA category 4{% elsif fh_lg == 'ar' %}IFRA الفئة 4{% else %}IFRA Kategorie 4{% endif %}{% if kmin != kmax %} · {% if fh_lg == 'en' %}depending on quality{% elsif fh_lg == 'ar' %}حسب الجودة{% else %}je nach Qualität{% endif %}{% endif %}</div>\n    </div>\n    <div class=\"fh-hl-v fh-serif\">\n      {{- kmin | append: '' | replace: '.', ',' -}}\n      {%- if kmin != kmax %} – {{ kmax | append: '' | replace: '.', ',' }}{% endif %} %\n    </div>\n  </div>\n  {%- endif -%}\n  {%- if td -%}\n  <div class=\"fh-grid\">\n    {%- if td.flammpunkt != blank -%}<div class=\"fh-kv\"><span>{% if fh_lg == 'en' %}Flash point{% elsif fh_lg == 'ar' %}نقطة الوميض{% else %}Flammpunkt{% endif %}</span><span>{{ td.flammpunkt }}</span></div>{%- endif -%}\n    {%- if td.dichte != blank -%}<div class=\"fh-kv\"><span>{% if fh_lg == 'en' %}Density (20 °C){% elsif fh_lg == 'ar' %}الكثافة (20 °م){% else %}Dichte (20 °C){% endif %}</span><span>{{ td.dichte }}</span></div>{%- endif -%}\n    {%- if td.loeslichkeit != blank -%}<div class=\"fh-kv\"><span>{% if fh_lg == 'en' %}Solubility{% elsif fh_lg == 'ar' %}الذوبانية{% else %}Löslichkeit{% endif %}</span><span>{{ td.loeslichkeit }}</span></div>{%- endif -%}\n    {%- if td.un != blank -%}<div class=\"fh-kv\"><span>{% if fh_lg == 'en' %}UN number{% elsif fh_lg == 'ar' %}رقم UN{% else %}UN-Nummer{% endif %}</span><span>{{ td.un }}</span></div>{%- endif -%}\n    {%- if td.ufi != blank -%}<div class=\"fh-kv\"><span>UFI</span><span>{{ td.ufi }}</span></div>{%- endif -%}\n    {%- if td.zoll != blank -%}<div class=\"fh-kv\"><span>{% if fh_lg == 'en' %}Customs tariff no.{% elsif fh_lg == 'ar' %}رقم التعرفة الجمركية{% else %}Zolltarif{% endif %}</span><span>{{ td.zoll }}</span></div>{%- endif -%}\n  </div>\n  {%- if td.signalwort != blank or td.hsaetze.size > 0 -%}\n  <div>\n    <span class=\"fh-lbl\">{% if fh_lg == 'en' %}Hazard statements{% elsif fh_lg == 'ar' %}بيانات الخطورة{% else %}Gefahrenhinweise{% endif %}</span>{% if td.signalwort != blank %}<span class=\"fh-lbl-s\">{% if fh_lg == 'en' %}Signal word{% elsif fh_lg == 'ar' %}كلمة التنبيه{% else %}Signalwort{% endif %}: <strong>{{ td.signalwort }}</strong></span>{% endif %}\n    <div class=\"fh-hz\" style=\"margin-top:10px\">\n      {%- for p in td.piktogramme -%}<img src=\"{{ p | downcase | append: '.svg' | file_url }}\" alt=\"{{ p }}\" loading=\"lazy\" width=\"40\" height=\"40\">{%- endfor -%}\n      {%- if td.hsaetze.size > 0 -%}<span>{{ td.hsaetze | join: ' · ' }}</span>{%- endif -%}\n    </div>\n  </div>\n  {%- endif -%}\n  {%- endif -%}\n</div>\n{%- endif -%}\n\n<div class=\"fh-trust\">\n  <div><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#a8823e\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6z\"></path><path d=\"M9 12l2 2 4-4\"></path></svg>{% if fh_lg == 'en' %}IFRA certificate included{% elsif fh_lg == 'ar' %}شهادة IFRA مشمولة{% else %}IFRA-Zertifikat inklusive{% endif %}</div>\n  <div><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#a8823e\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z\"></path><path d=\"M14 3v5h5\"></path><path d=\"M9 13h6M9 17h6\"></path></svg>{% if fh_lg == 'en' %}Safety data sheet (SDS){% elsif fh_lg == 'ar' %}صحيفة بيانات السلامة (SDS){% else %}Sicherheitsdatenblatt (SDB){% endif %}</div>\n  <div><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#a8823e\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3c3.5 4.2 6 7.4 6 10.5a6 6 0 0 1-12 0C6 10.4 8.5 7.2 12 3z\"></path></svg>{% if fh_lg == 'en' %}Freshly filled for every order{% elsif fh_lg == 'ar' %}تعبئة طازجة لكل طلب{% else %}Frisch abgefüllt pro Bestellung{% endif %}</div>\n</div>\n\n{%- if muster -%}\n<div class=\"fh-cta\">\n  <div>\n    <div class=\"fh-h fh-serif\" style=\"font-size:2.3rem\">{% if fh_lg == 'en' %}Test first, then order{% elsif fh_lg == 'ar' %}جرّب أولاً ثم اطلب{% else %}Erst testen, dann bestellen{% endif %}</div>\n    <p>{% if fh_lg == 'en' %}Samples before large orders · Support with product registration · Advice 1:30–4:30 pm{% elsif fh_lg == 'ar' %}عينات قبل الطلبات الكبيرة · دعم في تسجيل المنتجات · استشارة من 13:30 حتى 16:30{% else %}Muster vor Großbestellungen · Unterstützung bei der Produktregistrierung · Beratung 13:30–16:30 Uhr{% endif %}</p>\n  </div>\n  {%- liquid\n    assign mq = 1\n    assign mp = muster.price\n    assign fh_ms = muster.sku | slice: -3, 3 | upcase\n    if fh_ms == '-1G'\n      assign mq = 6\n      assign mp = muster.price | times: 6\n    endif\n  -%}\n  <a class=\"fh-btn\" href=\"/cart/{{ muster.id }}:{{ mq }}\">{% if fh_lg == 'en' %}Request sample{% elsif fh_lg == 'ar' %}اطلب عينة{% else %}Muster anfordern{% endif %} · {% if mq > 1 %}{% if fh_lg == 'en' %}6 g{% elsif fh_lg == 'ar' %}6 غ{% else %}6 g{% endif %} {% endif %}{{ mp | money }}</a>\n</div>\n{%- endif -%}\n</div>\n{%- endif -%}"
          }
        },
