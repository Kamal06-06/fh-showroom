        "custom_liquid": "{%- liquid\n  assign en = false\n  if request.locale.iso_code != 'de'\n    assign en = true\n  endif\n  assign r = routes.root_url\n  if r == '/'\n    assign r = ''\n  endif\n-%}\n{%- assign desktop_de = 'https://cdn.shopify.com/s/files/1/0929/4571/1487/files/flakons-desktop-de.jpg?v=1790865082' -%}\n{%- assign mobile_de  = 'https://cdn.shopify.com/s/files/1/0929/4571/1487/files/flakons-mobile-de.jpg?v=1790865079' -%}\n{%- assign desktop_en = 'https://cdn.shopify.com/s/files/1/0929/4571/1487/files/flakons-desktop-en.jpg?v=1790865083' -%}\n{%- assign mobile_en  = 'https://cdn.shopify.com/s/files/1/0929/4571/1487/files/flakons-mobile-en.jpg?v=1790865079' -%}\n{%- assign link = '/pages/contact' -%}\n{%- assign alt_de = 'Fragrance Hub Germany' -%}\n{%- assign alt_en = 'Fragrance Hub Germany' -%}\n\n{%- liquid\n  if en and desktop_en != ''\n    assign d = desktop_en\n    assign m = mobile_en\n    assign alt = alt_en\n  else\n    assign d = desktop_de\n    assign m = mobile_de\n    assign alt = alt_de\n  endif\n  if m == ''\n    assign m = d\n  endif\n-%}\n{%- if d != '' -%}\n<div class=\"fhbn\">\n  <a class=\"fhbn__link\" href=\"{{ r }}{{ link }}\">\n    <picture>\n      <source media=\"(max-width: 749px)\" srcset=\"{{ m }}\">\n      <img src=\"{{ d }}\" alt=\"{{ alt }}\" loading=\"lazy\" width=\"1920\" height=\"900\">\n    </picture>\n  </a>\n</div>\n<style>\n  .fhbn{max-width:1200px;margin:0 auto;padding:2.4rem 1.6rem}\n  .fhbn__link{display:block;border-radius:6px;overflow:hidden;box-shadow:0 10px 30px rgba(31,36,51,.12);transition:transform .3s,box-shadow .3s}\n  .fhbn__link:hover{transform:translateY(-2px);box-shadow:0 16px 40px rgba(31,36,51,.18)}\n  .fhbn__link:focus-visible{outline:2px solid #B8963E;outline-offset:3px}\n  .fhbn img{display:block;width:100%;height:auto}\n  @media(min-width:750px){.fhbn{padding:4rem 1.6rem}}\n  @media(prefers-reduced-motion:reduce){.fhbn__link{transition:none}}\n</style>\n{%- endif -%}",
