        "padding_bottom": 52
      }
    },
    "custom_liquid_Um9iay": {
      "type": "custom-liquid",
      "name": "lager foto",
      "settings": {
        "custom_liquid": "{%- liquid\n  assign en = false\n  if request.locale.iso_code != 'de'\n    assign en = true\n  endif\n  assign r = routes.root_url\n  if r == '/'\n    assign r = ''\n  endif\n-%}\n{%- comment -%}\n BILD-BANNER (Desktop + Handy, Deutsch + Englisch)\n Links aus Inhalt > Dateien einfügen. link = Ziel beim Klick.\n{%- endcomment -%}\n{%- assign desktop_de = 'https://cdn.shopify.com/s/files/1/0929/4571/1487/files/lager-desktop-de.jpg?v=1790865082' -%}\n{%- assign mobile_de  = 'https://cdn.shopify.com/s/files/1/0929/4571/1487/files/lager-mobile-de.jpg?v=1790865079' -%}\n{%- assign desktop_en = 'https://cdn.shopify.com/s/files/1/0929/4571/1487/files/lager-desktop-en.jpg?v=1790865083' -%}\n{%- assign mobile_en  = 'https://cdn.shopify.com/s/files/1/0929/4571/1487/files/lager-mobile-en.jpg?v=1790865078' -%}\n{%- assign link = '/pages/contact' -%}\n{%- assign alt_de = 'Fragrance Hub Germany' -%}\n{%- assign alt_en = 'Fragrance Hub Germany' -%}\n\n{%- liquid\n  if en and desktop_en != ''\n    assign d = desktop_en\n    assign m = mobile_en\n    assign alt = alt_en\n  else\n    assign d = desktop_de\n    assign m = mobile_de\n    assign alt = alt_de\n  endif\n  if m == ''\n    assign m = d\n  endif\n-%}\n{%- if d != '' -%}\n<div class=\"fhbn\">\n  <a class=\"fhbn__link\" href=\"{{ r }}{{ link }}\">\n    <picture>\n      <source media=\"(max-width: 749px)\" srcset=\"{{ m }}\">\n      <img src=\"{{ d }}\" alt=\"{{ alt }}\" loading=\"lazy\" width=\"1920\" height=\"900\">\n    </picture>\n  </a>\n</div>\n<style>\n  .fhbn{max-width:1200px;margin:0 auto;padding:2.4rem 1.6rem}\n  .fhbn__link{display:block;border-radius:6px;overflow:hidden;box-shadow:0 10px 30px rgba(31,36,51,.12);transition:transform .3s,box-shadow .3s}\n  .fhbn__link:hover{transform:translateY(-2px);box-shadow:0 16px 40px rgba(31,36,51,.18)}\n  .fhbn__link:focus-visible{outline:2px solid #B8963E;outline-offset:3px}\n  .fhbn img{display:block;width:100%;height:auto}\n  @media(min-width:750px){.fhbn{padding:4rem 1.6rem}}\n  @media(prefers-reduced-motion:reduce){.fhbn__link{transition:none}}\n</style>\n{%- endif -%}",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_9rryft": {
      "type": "custom-liquid",
      "name": "Bestseller",
      "settings": {
        "custom_liquid": "{%- comment -%}\n BESTSELLER – KARUSSELL (bewegt sich automatisch, wischen auf dem Handy, Pfeile am PC)\n fh_anzahl = Anzahl Produkte, fh_takt = Sekunden pro Schritt\n{%- endcomment -%}\n{%- assign fh_anzahl = 12 -%}\n{%- assign fh_takt = 3 -%}\n{%- assign fh_best = nil -%}\n{%- for l in linklists['main-menu'].links -%}\n  {%- if l.title contains 'Bestseller' and l.type == 'collection_link' -%}{%- assign fh_best = l -%}{%- endif -%}\n{%- endfor -%}\n{%- if fh_best and fh_best.object.products_count > 0 -%}\n{%- assign bc = fh_best.object -%}\n<div class=\"fhc-band\"><section class=\"fhx fhx-sec fhc\" id=\"fhc-{{ section.id }}\" aria-roledescription=\"{% if request.locale.iso_code == 'en' %}Carousel{% elsif request.locale.iso_code == 'ar' %}عرض متحرك{% else %}Karussell{% endif %}\" aria-label=\"{% if request.locale.iso_code == 'en' %}Most purchased fragrance oils{% elsif request.locale.iso_code == 'ar' %}الزيوت العطرية الأكثر شراءً{% else %}Meistgekaufte Duftöle{% endif %}\">\n  <div class=\"fhc__head\">\n    <div>\n      <p class=\"fhc__kicker\">{% if request.locale.iso_code == 'en' %}Bestsellers{% elsif request.locale.iso_code == 'ar' %}الأكثر مبيعاً{% else %}Bestseller{% endif %}</p>\n      <h2>{% if request.locale.iso_code == 'en' %}Most purchased fragrance oils{% elsif request.locale.iso_code == 'ar' %}الزيوت العطرية الأكثر شراءً{% else %}Meistgekaufte Duftöle{% endif %}</h2>\n      <p>{% if request.locale.iso_code == 'en' %}The fragrance oils our business customers reorder most often.{% elsif request.locale.iso_code == 'ar' %}الزيوت العطرية التي يعيد عملاؤنا التجاريون طلبها أكثر من غيرها.{% else %}Die Duftöle, die unsere Gewerbekunden am häufigsten nachbestellen.{% endif %}</p>\n    </div>\n    <div class=\"fhc__ctrl\">\n      <button type=\"button\" class=\"fhc__btn\" data-dir=\"-1\" aria-label=\"{% if request.locale.iso_code == 'en' %}Back{% elsif request.locale.iso_code == 'ar' %}السابق{% else %}Zurück{% endif %}\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M15 5l-7 7 7 7\"/></svg>\n      </button>\n      <button type=\"button\" class=\"fhc__btn\" data-dir=\"1\" aria-label=\"{% if request.locale.iso_code == 'en' %}Next{% elsif request.locale.iso_code == 'ar' %}التالي{% else %}Weiter{% endif %}\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M9 5l7 7-7 7\"/></svg>\n      </button>\n    </div>\n  </div>\n\n  <ul class=\"fhc__track\" tabindex=\"0\">\n    {%- for p in bc.products limit: fh_anzahl -%}\n      <li class=\"fhc__item\">\n        <a href=\"{{ p.url }}\" class=\"fhc__link\">\n          <div class=\"fhc__img\">\n            {%- if p.featured_image -%}\n              {{ p.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: p.title, sizes: '(min-width: 990px) 25vw, 70vw' }}\n            {%- endif -%}\n          </div>\n          <span class=\"fhc__title\">{{ p.title }}</span>\n          {%- assign fh_min = p.price_min -%}{%- assign fh_has = false -%}{%- for fv in p.variants -%}{%- assign fh_vp = fv.price -%}{%- assign fh_s3 = fv.sku | slice: -3, 3 | upcase -%}{%- if fh_s3 == '-1G' -%}{%- assign fh_vp = fv.price | times: 6 -%}{%- endif -%}{%- if fh_has == false or fh_vp < fh_min -%}{%- assign fh_min = fh_vp -%}{%- assign fh_has = true -%}{%- endif -%}{%- endfor -%}<span class=\"fhc__price\">{% if request.locale.iso_code == 'en' %}from{% elsif request.locale.iso_code == 'ar' %}من{% else %}ab{% endif %} {{ fh_min | money }} <small>{% if request.locale.iso_code == 'en' %}plus VAT{% elsif request.locale.iso_code == 'ar' %}غير شامل الضريبة{% else %}zzgl. MwSt.{% endif %}</small></span>\n        </a>\n      </li>\n    {%- endfor -%}\n  </ul>\n\n  <div class=\"fhc__foot\">\n    <div class=\"fhc__bar\"><span></span></div>\n    <a class=\"fhc__all\" href=\"{{ bc.url }}\">{% if request.locale.iso_code == 'en' %}View all bestsellers{% elsif request.locale.iso_code == 'ar' %}عرض جميع الأكثر مبيعاً{% else %}Alle Bestseller ansehen{% endif %}</a>\n  </div>\n</section></div>\n\n<style>\n  .fhc-band{background:#1F2433;background-image:radial-gradient(ellipse 60% 80% at 85% 0%,rgba(184,150,62,.16),transparent 70%)}\n  .fhc{color:#fff}\n  .fhc h2{color:#fff}\n  .fhc .fhc__head p{color:rgba(255,255,255,.7)}\n  .fhc__kicker{color:#D9BF7A!important;font-size:1.3rem!important;letter-spacing:.15rem;margin-bottom:.8rem!important}\n  .fhc__head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;margin-bottom:3.2rem}\n  .fhc__ctrl{display:none;gap:1rem}\n  .fhc__btn{width:4.8rem;height:4.8rem;border:1px solid rgba(217,191,122,.6);border-radius:50%;background:transparent;cursor:pointer;\n    display:flex;align-items:center;justify-content:center;transition:background .25s,border-color .25s}\n  .fhc__btn:hover{background:#B8963E;border-color:#B8963E}\n  .fhc__btn svg{width:2rem;height:2rem;fill:none;stroke:#D9BF7A;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n  .fhc__btn:hover svg{stroke:#1F2433}\n  .fhc__btn:focus-visible,.fhc__track:focus-visible,.fhc__link:focus-visible,.fhc__all:focus-visible{outline:2px solid #D9BF7A;outline-offset:3px}\n  .fhc__track{list-style:none;margin:0;padding:0 0 .4rem;display:flex;gap:1.6rem;overflow-x:auto;\n    scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none;-webkit-overflow-scrolling:touch}\n  .fhc__track::-webkit-scrollbar{display:none}\n  .fhc__item{flex:0 0 74%;scroll-snap-align:start}\n  .fhc__link{display:flex;flex-direction:column;text-decoration:none;color:#fff}\n  .fhc__img{position:relative;aspect-ratio:1/1;overflow:hidden;border-radius:2px;background:#2A3042;\n    box-shadow:0 0 0 1px rgba(217,191,122,.25);transition:box-shadow .3s}\n  .fhc__link:hover .fhc__img{box-shadow:0 0 0 1px #D9BF7A,0 18px 40px rgba(0,0,0,.35)}\n  .fhc__img img{width:100%;height:100%;object-fit:cover;transition:transform .6s}\n  .fhc__link:hover .fhc__img img{transform:scale(1.05)}\n  .fhc__rank{position:absolute;top:1rem;left:1rem;padding:.3rem .8rem;background:rgba(31,36,51,.85);\n    color:#D9BF7A;font-size:1.3rem;font-weight:700;letter-spacing:.1rem;border:1px solid rgba(217,191,122,.5)}\n  .fhc__title{margin-top:1.6rem;font-size:1.6rem;font-weight:600;line-height:1.35;color:#fff}\n  .fhc__price{margin-top:.4rem;font-size:1.45rem;color:#D9BF7A}\n  .fhc__price small{font-size:1.2rem;color:rgba(255,255,255,.55)}\n  .fhc__foot{display:flex;flex-direction:column;gap:2.4rem;margin-top:3.2rem}\n  .fhc__bar{height:2px;background:rgba(255,255,255,.12);position:relative;overflow:hidden}\n  .fhc__bar span{position:absolute;left:0;top:0;bottom:0;width:20%;background:#D9BF7A;transition:left .4s,width .4s}\n  .fhc__all{align-self:flex-start;color:#fff;font-size:1.5rem;font-weight:600;text-decoration:none;\n    padding-bottom:.4rem;border-bottom:1px solid #D9BF7A}\n  .fhc__all:hover{color:#D9BF7A}\n  @media(min-width:750px){\n    .fhc__ctrl{display:flex}\n    .fhc__track{gap:2.4rem}\n    .fhc__item{flex:0 0 calc((100% - 7.2rem)/4)}\n    .fhc__foot{flex-direction:row;align-items:center;gap:4rem}\n    .fhc__bar{flex:1}\n  }\n  @media(prefers-reduced-motion:reduce){.fhc__track{scroll-behavior:auto}.fhc__img img,.fhc__bar span{transition:none}}\n</style>\n\n<script>\n(function(){\n  var root = document.getElementById('fhc-{{ section.id }}');\n  if (!root) return;\n  var track = root.querySelector('.fhc__track');\n  var takt = {{ fh_takt }} * 1000;\n  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  var paused = false, timer = null;\n\n  function step(){\n    var item = track.querySelector('.fhc__item');\n    if (!item) return 0;\n    var gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;\n    return item.getBoundingClientRect().width + gap;\n  }\n  function move(dir){\n    var max = track.scrollWidth - track.clientWidth - 2;\n    if (dir > 0 && track.scrollLeft >= max) { track.scrollTo({left:0}); return; }\n    if (dir < 0 && track.scrollLeft <= 2) { track.scrollTo({left:max}); return; }\n    track.scrollBy({left: dir * step()});\n  }\n  function start(){ if (reduce) return; stop(); timer = setInterval(function(){ if (!paused) move(1); }, takt); }\n  function stop(){ if (timer) clearInterval(timer); }\n\n  root.querySelectorAll('.fhc__btn').forEach(function(b){\n    b.addEventListener('click', function(){ move(+b.dataset.dir); start(); });\n  });\n  ['mouseenter','focusin','touchstart'].forEach(function(e){ root.addEventListener(e, function(){ paused = true; }, {passive:true}); });\n  ['mouseleave','focusout'].forEach(function(e){ root.addEventListener(e, function(){ paused = false; }); });\n  root.addEventListener('touchend', function(){ setTimeout(function(){ paused = false; }, 4000); }, {passive:true});\n  document.addEventListener('visibilitychange', function(){ document.hidden ? stop() : start(); });\n\n  var bar = root.querySelector('.fhc__bar span');\n  function prog(){\n    var w = track.clientWidth / track.scrollWidth;\n    var l = track.scrollLeft / track.scrollWidth;\n    bar.style.width = (w*100)+'%'; bar.style.left = (l*100)+'%';\n  }\n  track.addEventListener('scroll', prog, {passive:true});\n  window.addEventListener('resize', prog);\n  prog();\n\n  start();\n})();\n</script>\n{%- endif -%}",
        "color_scheme": "scheme-1",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
