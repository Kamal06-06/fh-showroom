{
  "sections": {
    "custom_liquid_y8r7e6": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<style>\n  .fhx{--gold:#B8963E;--gold-soft:#F6EEDC;--ink:#262B3B;--muted:#5E6272;--line:#E7E1D3;\n       direction:ltr;text-align:left;color:var(--ink);max-width:1200px;margin:0 auto;padding:0 1.6rem}\n  .fhx h2{font-size:2.6rem;line-height:1.25;margin:0 0 .6rem;font-weight:600;letter-spacing:0}\n  .fhx p{font-size:1.6rem;line-height:1.6;color:var(--muted);margin:0}\n  .fhx-btn{display:inline-block;padding:1.2rem 2.2rem;border-radius:4px;font-size:1.5rem;font-weight:600;\n           text-decoration:none;border:1.5px solid var(--gold);transition:background .2s,color .2s}\n  .fhx-btn--solid{background:var(--gold);color:#fff}\n  .fhx-btn--solid:hover{background:#9C7D30;border-color:#9C7D30}\n  .fhx-btn--ghost{color:#fff;border-color:#fff}\n  .fhx-btn--ghost:hover{background:#fff;color:var(--ink)}\n  .fhx-btn--line{color:var(--ink)}\n  .fhx-btn--line:hover{background:var(--gold);color:#fff}\n  .fhx-btn:focus-visible{outline:2px solid var(--gold);outline-offset:3px}\n  .fhx-sec{padding:4.8rem 0}\n  @media(min-width:750px){.fhx h2{font-size:3.2rem}.fhx-sec{padding:6.4rem 0}}\n</style>\n\n{%- comment -%}\n STARTSEITE – HERO (Slideshow)\n Bild-Links eintragen: Inhalt > Dateien > Bild hochladen > Link kopieren. Leer = dunkler Hintergrund.\n{%- endcomment -%}\n{%- assign bild1 = '' -%}\n{%- assign bild2 = '' -%}\n{%- assign bild3 = '' -%}\n{%- assign bild4 = '' -%}\n{%- assign bild5 = '' -%}\n{%- assign takt = 6 -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&display=swap\" rel=\"stylesheet\">\n\n<section class=\"fhn\" id=\"fhn-{{ section.id }}\" aria-roledescription=\"{% if request.locale.iso_code == 'en' %}Carousel{% elsif request.locale.iso_code == 'ar' %}عرض متحرك{% else %}Karussell{% endif %}\" aria-label=\"Fragrance Hub Germany\">\n  <div class=\"fhn__media\">\n    {%- assign bilder = bild1 | append: '|' | append: bild2 | append: '|' | append: bild3 | append: '|' | append: bild4 | append: '|' | append: bild5 | split: '|' -%}\n    {%- for i in (0..4) -%}\n      <div class=\"fhn__bg{% if forloop.first %} is-active{% endif %}\"{% if bilder[i] != blank %} style=\"--img:url('{{ bilder[i] }}')\"{% endif %}></div>\n    {%- endfor -%}\n    <div class=\"fhn__shade\"></div>\n  </div>\n\n  <div class=\"fhx fhn__inner\">\n    <header class=\"fhn__brand\">\n      <p class=\"fhn__name\">Fragrance Hub</p>\n      <p class=\"fhn__country\">Germany</p>\n      <p class=\"fhn__reach\">{% if request.locale.iso_code == 'en' %}From Germany across Europe – bulk quantities to the Middle East{% elsif request.locale.iso_code == 'ar' %}من ألمانيا إلى كل أوروبا – وكميات كبيرة حتى الشرق الأوسط{% else %}Aus Deutschland in ganz Europa – Großmengen bis in den Nahen Osten{% endif %}</p>\n    </header>\n\n    <div class=\"fhn__stage\">\n      <article class=\"fhn__slide is-active\">\n        <p class=\"fhn__kicker\">{% if request.locale.iso_code == 'en' %}Wholesale perfume oils{% elsif request.locale.iso_code == 'ar' %}تجارة الجملة للزيوت العطرية{% else %}Großhandel für Parfümöle{% endif %}</p>\n        <h2 class=\"fhn__title\">{% if request.locale.iso_code == 'en' %}Perfume oils for your own fragrance brand{% elsif request.locale.iso_code == 'ar' %}زيوت عطرية لعلامتك العطرية الخاصة{% else %}Parfümöle für Ihre eigene Duftmarke{% endif %}</h2>\n        <p class=\"fhn__text\">{% if request.locale.iso_code == 'en' %}Over 1,200 fragrance oils – freshly filled for business customers.{% elsif request.locale.iso_code == 'ar' %}أكثر من 1200 زيت عطري – تُعبّأ طازجة للعملاء التجاريين.{% else %}Über 1.200 Duftöle – frisch abgefüllt für Gewerbekunden.{% endif %}</p>\n        <div class=\"fhn__btns\">\n          <a class=\"fhx-btn fhx-btn--solid\" href=\"/collections/all\">{% if request.locale.iso_code == 'en' %}Explore the range{% elsif request.locale.iso_code == 'ar' %}اكتشف التشكيلة{% else %}Sortiment entdecken{% endif %}</a>\n          <a class=\"fhx-btn fhx-btn--ghost\" href=\"/pages/contact\">{% if request.locale.iso_code == 'en' %}Request samples{% elsif request.locale.iso_code == 'ar' %}اطلب عينات{% else %}Muster anfragen{% endif %}</a>\n        </div>\n      </article>\n\n      <article class=\"fhn__slide\">\n        <p class=\"fhn__kicker\">{% if request.locale.iso_code == 'en' %}Flexible quantities{% elsif request.locale.iso_code == 'ar' %}كميات مرنة{% else %}Flexible Mengen{% endif %}</p>\n        <h2 class=\"fhn__title\">{% if request.locale.iso_code == 'en' %}From 6 g samples to over 1,000&nbsp;kg{% elsif request.locale.iso_code == 'ar' %}من عينة 6 غ حتى أكثر من 1000&nbsp;كغ{% else %}Vom 6-g-Muster bis über 1.000&nbsp;kg{% endif %}</h2>\n        <p class=\"fhn__text\">{% if request.locale.iso_code == 'en' %}Test at your own pace – then order in production quantities.{% elsif request.locale.iso_code == 'ar' %}جرّب على راحتك – ثم اطلب بكميات الإنتاج.{% else %}Testen Sie in Ruhe – und bestellen Sie dann in Produktionsmengen.{% endif %}</p>\n        <div class=\"fhn__btns\">\n          <a class=\"fhx-btn fhx-btn--solid\" href=\"/collections/all\">{% if request.locale.iso_code == 'en' %}View fragrance oils{% elsif request.locale.iso_code == 'ar' %}عرض الزيوت العطرية{% else %}Duftöle ansehen{% endif %}</a>\n          <a class=\"fhx-btn fhx-btn--ghost\" href=\"/pages/contact\">{% if request.locale.iso_code == 'en' %}Request bulk quantity{% elsif request.locale.iso_code == 'ar' %}اطلب كمية كبيرة{% else %}Großmenge anfragen{% endif %}</a>\n        </div>\n      </article>\n\n      <article class=\"fhn__slide\">\n        <p class=\"fhn__kicker\">{% if request.locale.iso_code == 'en' %}Export{% elsif request.locale.iso_code == 'ar' %}التصدير{% else %}Export{% endif %}</p>\n        <h2 class=\"fhn__title\">{% if request.locale.iso_code == 'en' %}Bulk quantities for the Middle East{% elsif request.locale.iso_code == 'ar' %}كميات كبيرة للشرق الأوسط{% else %}Großmengen für den Nahen Osten{% endif %}</h2>\n        <p class=\"fhn__text\">{% if request.locale.iso_code == 'en' %}For buyers in the Middle East we supply bulk quantities directly from Germany – with an individual quote.{% elsif request.locale.iso_code == 'ar' %}للمشترين في الشرق الأوسط نورّد كميات كبيرة مباشرة من ألمانيا – مع عرض سعر خاص.{% else %}Für Abnehmer im Nahen Osten liefern wir Großmengen direkt ab Deutschland – mit individuellem Angebot.{% endif %}</p>\n        <div class=\"fhn__btns\">\n          <a class=\"fhx-btn fhx-btn--solid\" href=\"/pages/contact\">{% if request.locale.iso_code == 'en' %}Send an export enquiry{% elsif request.locale.iso_code == 'ar' %}أرسل طلب تصدير{% else %}Exportanfrage stellen{% endif %}</a>\n        </div>\n      </article>\n\n      <article class=\"fhn__slide\">\n        <p class=\"fhn__kicker\">{% if request.locale.iso_code == 'en' %}Documented &amp; safe{% elsif request.locale.iso_code == 'ar' %}موثّق وآمن{% else %}Dokumentiert &amp; sicher{% endif %}</p>\n        <h2 class=\"fhn__title\">{% if request.locale.iso_code == 'en' %}IFRA, SDS and CLP label for every fragrance oil{% elsif request.locale.iso_code == 'ar' %}شهادة IFRA وصحيفة السلامة وملصق CLP لكل زيت عطري{% else %}IFRA, SDS und CLP-Etikett zu jedem Duftöl{% endif %}</h2>\n        <p class=\"fhn__text\">{% if request.locale.iso_code == 'en' %}All documents for your own perfume line – available immediately on request.{% elsif request.locale.iso_code == 'ar' %}جميع المستندات لخط عطورك الخاص – متوفرة فوراً عند الطلب.{% else %}Alle Unterlagen für Ihre eigene Parfümlinie – auf Anfrage sofort verfügbar.{% endif %}</p>\n        <div class=\"fhn__btns\">\n          <a class=\"fhx-btn fhx-btn--solid\" href=\"/pages/contact\">{% if request.locale.iso_code == 'en' %}Request documents{% elsif request.locale.iso_code == 'ar' %}اطلب المستندات{% else %}Unterlagen anfragen{% endif %}</a>\n        </div>\n      </article>\n\n      <article class=\"fhn__slide\">\n        <p class=\"fhn__kicker\">{% if request.locale.iso_code == 'en' %}Service for founders{% elsif request.locale.iso_code == 'ar' %}خدمة لرواد الأعمال{% else %}Service für Gründer{% endif %}</p>\n        <h2 class=\"fhn__title\">{% if request.locale.iso_code == 'en' %}Product registration from A to Z{% elsif request.locale.iso_code == 'ar' %}تسجيل المنتجات من الألف إلى الياء{% else %}Produktregistrierung von A bis Z{% endif %}</h2>\n        <p class=\"fhn__text\">{% if request.locale.iso_code == 'en' %}Our experienced team supports you from the first scent to the finished brand.{% elsif request.locale.iso_code == 'ar' %}يرافقك فريقنا ذو الخبرة من أول عطر حتى العلامة التجارية الجاهزة.{% else %}Unser erfahrenes Team begleitet Sie vom ersten Duft bis zur fertigen Marke.{% endif %}</p>\n        <div class=\"fhn__btns\">\n          <a class=\"fhx-btn fhx-btn--solid\" href=\"/pages/contact\">{% if request.locale.iso_code == 'en' %}Request advice{% elsif request.locale.iso_code == 'ar' %}اطلب استشارة{% else %}Beratung anfragen{% endif %}</a>\n        </div>\n      </article>\n    </div>\n\n    <div class=\"fhn__nav\">\n      <span class=\"fhn__count\"><b>01</b> / 05</span>\n      <div class=\"fhn__dots\">\n        {%- for i in (1..5) -%}\n          <button type=\"button\" class=\"fhn__dot{% if forloop.first %} is-active{% endif %}\" aria-label=\"Folie {{ i }}\"><span></span></button>\n        {%- endfor -%}\n      </div>\n    </div>\n  </div>\n</section>\n\n<div class=\"fhn-facts\">\n  <div class=\"fhx fhn-facts__grid\">\n    <div><strong>1.200+</strong><span>{% if request.locale.iso_code == 'en' %}fragrance oils in our range{% elsif request.locale.iso_code == 'ar' %}زيت عطري في التشكيلة{% else %}Duftöle im Sortiment{% endif %}</span></div>\n    <div><strong>6 g – 1.000+ kg</strong><span>{% if request.locale.iso_code == 'en' %}From sample to bulk{% elsif request.locale.iso_code == 'ar' %}من العينة حتى الكميات الكبيرة{% else %}Vom Muster bis zur Großmenge{% endif %}</span></div>\n    <div><strong>{% if request.locale.iso_code == 'en' %}12 noon{% elsif request.locale.iso_code == 'ar' %}12 ظهراً{% else %}12 Uhr{% endif %}</strong><span>{% if request.locale.iso_code == 'en' %}Order cut-off for same-day shipping{% elsif request.locale.iso_code == 'ar' %}آخر موعد للطلب للشحن في نفس اليوم{% else %}Bestellschluss für Versand am selben Tag{% endif %}</span></div>\n    <div><strong>{% if request.locale.iso_code == 'en' %}EU &amp; Middle East{% elsif request.locale.iso_code == 'ar' %}أوروبا والشرق الأوسط{% else %}EU &amp; Nahost{% endif %}</strong><span>{% if request.locale.iso_code == 'en' %}Europe in 1–3 days, bulk quantities to the Middle East{% elsif request.locale.iso_code == 'ar' %}أوروبا خلال 1–3 أيام، وكميات كبيرة للشرق الأوسط{% else %}Europa in 1–3 Tagen, Großmengen in den Nahen Osten{% endif %}</span></div>\n  </div>\n</div>\n\n<style>\n  .fhn{position:relative;min-height:88vh;display:flex;overflow:hidden;background:#171B27;color:#fff}\n  .fhn__media{position:absolute;inset:0}\n  .fhn__bg{--img:none;position:absolute;inset:0;opacity:0;transition:opacity 1.2s ease;\n    background-image:var(--img),radial-gradient(ellipse 80% 60% at 85% 20%,rgba(184,150,62,.28),transparent 65%),\n      radial-gradient(ellipse 60% 50% at 10% 90%,rgba(184,150,62,.12),transparent 70%);\n    background-size:cover;background-position:center;transform:scale(1.08)}\n  .fhn__bg.is-active{opacity:1;animation:fhnZoom 10s ease-out forwards}\n  @keyframes fhnZoom{from{transform:scale(1.08)}to{transform:scale(1)}}\n  .fhn__shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(23,27,39,.75) 0%,rgba(23,27,39,.35) 35%,rgba(23,27,39,.9) 100%)}\n  .fhn__inner{position:relative;width:100%;display:flex;flex-direction:column;justify-content:space-between;\n    padding-top:4rem;padding-bottom:3.2rem;min-height:88vh}\n\n  .fhn__brand{border-bottom:1px solid rgba(217,191,122,.35);padding-bottom:2rem}\n  .fhn__name{font-family:'Cormorant Garamond',Georgia,'Times New Roman',serif!important;font-weight:600;\n    font-size:5rem!important;line-height:.95!important;color:#D9BF7A!important;margin:0!important;letter-spacing:-.05rem}\n  .fhn__country{font-family:'Cormorant Garamond',Georgia,serif!important;font-size:1.8rem!important;letter-spacing:.9rem;\n    color:#D9BF7A!important;margin:.6rem 0 1.6rem!important;text-transform:uppercase;opacity:.85}\n  .fhn__reach{font-size:1.45rem!important;color:rgba(255,255,255,.85)!important;margin:0!important;max-width:34em}\n\n  .fhn__stage{position:relative;flex:1;display:grid;align-items:end;margin-top:3.2rem}\n  .fhn__slide{grid-area:1/1;opacity:0;visibility:hidden;transition:opacity .8s ease,visibility .8s}\n  .fhn__slide.is-active{opacity:1;visibility:visible}\n  .fhn__slide>*{transform:translateY(18px);opacity:0;transition:transform .8s ease,opacity .8s ease}\n  .fhn__slide.is-active>*{transform:none;opacity:1}\n  .fhn__slide.is-active>*:nth-child(2){transition-delay:.12s}\n  .fhn__slide.is-active>*:nth-child(3){transition-delay:.24s}\n  .fhn__slide.is-active>*:nth-child(4){transition-delay:.36s}\n  .fhn__kicker{color:#D9BF7A!important;font-size:1.35rem!important;font-weight:600;margin:0 0 1rem!important}\n  .fhn__title{color:#fff!important;font-size:3.2rem!important;line-height:1.12!important;font-weight:700!important;margin:0 0 1.2rem!important;max-width:14em}\n  .fhn__text{color:rgba(255,255,255,.82)!important;font-size:1.55rem!important;max-width:32em;margin:0 0 2.4rem!important}\n  .fhn__btns{display:flex;flex-wrap:wrap;gap:1.2rem}\n\n  .fhn__nav{display:flex;align-items:center;gap:2rem;margin-top:3.2rem}\n  .fhn__count{font-size:1.3rem;color:rgba(255,255,255,.6);font-variant-numeric:tabular-nums;white-space:nowrap}\n  .fhn__count b{color:#fff;font-weight:700}\n  .fhn__dots{display:flex;gap:.6rem;flex:1;max-width:32rem}\n  .fhn__dot{flex:1;height:2.4rem;padding:0;border:0;background:transparent;cursor:pointer;display:flex;align-items:center}\n  .fhn__dot span{display:block;width:100%;height:2px;background:rgba(255,255,255,.25);position:relative;overflow:hidden}\n  .fhn__dot span::after{content:\"\";position:absolute;inset:0;background:#D9BF7A;transform:scaleX(0);transform-origin:left}\n  .fhn__dot.is-done span::after{transform:scaleX(1)}\n  .fhn__dot.is-active span::after{animation:fhnBar var(--takt,6s) linear forwards}\n  .fhn.is-paused .fhn__dot.is-active span::after{animation-play-state:paused}\n  @keyframes fhnBar{to{transform:scaleX(1)}}\n  .fhn__dot:focus-visible{outline:2px solid #D9BF7A;outline-offset:2px}\n\n  .fhn-facts{background:#FAF8F3;border-bottom:1px solid #E7E1D3}\n  .fhn-facts__grid{display:grid;grid-template-columns:1fr 1fr}\n  .fhn-facts__grid>div{padding:2rem 1.2rem 2.2rem 0}\n  .fhn-facts strong{display:block;font-size:2rem;font-weight:700;color:#262B3B;line-height:1.2}\n  .fhn-facts span{display:block;font-size:1.3rem;color:#5E6272;margin-top:.4rem;line-height:1.4}\n\n  @media(min-width:750px){\n    .fhn,.fhn__inner{min-height:82vh}\n    .fhn__inner{padding-top:6.4rem;padding-bottom:4.8rem}\n    .fhn__brand{display:grid;grid-template-columns:auto 1fr;column-gap:4rem;align-items:end}\n    .fhn__name{font-size:8.8rem!important;grid-column:1}\n    .fhn__country{grid-column:1;font-size:2.2rem!important;letter-spacing:1.4rem;margin-bottom:0!important}\n    .fhn__reach{grid-column:2;grid-row:1/3;align-self:end;justify-self:end;text-align:right;font-size:1.6rem!important}\n    .fhn__title{font-size:5.2rem!important}\n    .fhn-facts__grid{grid-template-columns:repeat(4,1fr)}\n    .fhn-facts__grid>div+div{padding-left:2.4rem;border-left:1px solid #E7E1D3}\n  }\n  @media(prefers-reduced-motion:reduce){\n    .fhn__bg,.fhn__slide,.fhn__slide>*{transition:none}\n    .fhn__bg.is-active{animation:none;transform:none}\n    .fhn__dot.is-active span::after{animation:none;transform:scaleX(1)}\n  }\n</style>\n\n<script>\n(function(){\n  var root = document.getElementById('fhn-{{ section.id }}');\n  if (!root || root.dataset.ready) return; root.dataset.ready = '1';\n  var slides = root.querySelectorAll('.fhn__slide'), bgs = root.querySelectorAll('.fhn__bg'),\n      dots = root.querySelectorAll('.fhn__dot'), count = root.querySelector('.fhn__count b');\n  var takt = {{ takt }} * 1000, i = 0, timer = null, x0 = null;\n  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n  root.style.setProperty('--takt', takt/1000 + 's');\n\n  function show(n){\n    i = (n + slides.length) % slides.length;\n    slides.forEach(function(s,k){ s.classList.toggle('is-active', k === i); s.setAttribute('aria-hidden', k !== i); });\n    bgs.forEach(function(b,k){ b.classList.toggle('is-active', k === i); });\n    dots.forEach(function(d,k){ d.classList.remove('is-active'); d.classList.toggle('is-done', k < i); void d.offsetWidth; if (k === i) d.classList.add('is-active'); });\n    count.textContent = (i < 9 ? '0' : '') + (i + 1);\n  }\n  function start(){ if (reduce) return; stop(); timer = setInterval(function(){ if (!root.classList.contains('is-paused')) show(i+1); }, takt); }\n  function stop(){ if (timer) clearInterval(timer); }\n\n  dots.forEach(function(d,k){ d.addEventListener('click', function(){ show(k); start(); }); });\n  root.addEventListener('mouseenter', function(){ root.classList.add('is-paused'); });\n  root.addEventListener('mouseleave', function(){ root.classList.remove('is-paused'); });\n  root.addEventListener('focusin', function(){ root.classList.add('is-paused'); });\n  root.addEventListener('focusout', function(){ root.classList.remove('is-paused'); });\n  root.addEventListener('touchstart', function(e){ x0 = e.touches[0].clientX; }, {passive:true});\n  root.addEventListener('touchend', function(e){\n    if (x0 === null) return; var dx = e.changedTouches[0].clientX - x0; x0 = null;\n    if (Math.abs(dx) > 40) { show(i + (dx < 0 ? 1 : -1)); start(); }\n  }, {passive:true});\n  document.addEventListener('visibilitychange', function(){ document.hidden ? stop() : start(); });\n\n  show(0); start();\n})();\n</script>",
        "color_scheme": "scheme-f0a87df2-f425-4be0-94a8-f93fad5e3198",
