    "custom_liquid_Dqi64M": {
      "type": "custom-liquid",
      "name": "Duftfamilien",
      "settings": {
        "custom_liquid": "{%- assign fh_fam = nil -%}\n{%- for l in linklists['main-menu'].links -%}\n  {%- if l.title == 'Duftfamilien' -%}{%- assign fh_fam = l -%}{%- endif -%}\n{%- endfor -%}\n{%- if fh_fam -%}\n<section class=\"fhx fhx-sec fhx-fam\">\n  <h2>{% if request.locale.iso_code == 'en' %}Shop by fragrance family{% elsif request.locale.iso_code == 'ar' %}اختر حسب العائلة العطرية{% else %}Nach Duftfamilie wählen{% endif %}</h2>\n  <p>{% if request.locale.iso_code == 'en' %}Find fragrance oils by character – from fresh citrus to oriental.{% elsif request.locale.iso_code == 'ar' %}اعثر على الزيوت العطرية حسب طابعها – من المنعش الحمضي حتى الشرقي.{% else %}Finden Sie Duftöle nach ihrem Charakter – von frisch-zitrisch bis orientalisch.{% endif %}</p>\n  <div class=\"fhx-fam__grid\">\n    {%- for l in fh_fam.links -%}\n      {%- assign c = l.object -%}\n      <a class=\"fhx-fam__card\" href=\"{{ l.url }}\">\n        {%- if c.image -%}\n          {{ c.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: l.title, class: 'fhx-fam__img' }}\n        {%- elsif c.products.first.featured_image -%}\n          {{ c.products.first.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: l.title, class: 'fhx-fam__img' }}\n        {%- endif -%}\n        <span class=\"fhx-fam__label\">{{ l.title }}{%- if c.products_count -%}<small>{{ c.products_count }} {% if request.locale.iso_code == 'en' %}fragrance oils{% elsif request.locale.iso_code == 'ar' %}زيت عطري{% else %}Duftöle{% endif %}</small>{%- endif -%}</span>\n      </a>\n    {%- endfor -%}\n  </div>\n</section>\n<style>\n  .fhx-fam__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1.2rem;margin-top:2.4rem}\n  .fhx-fam__card{position:relative;display:block;aspect-ratio:4/5;overflow:hidden;border-radius:6px;background:#F6EEDC;text-decoration:none}\n  .fhx-fam__img{width:100%;height:100%;object-fit:cover;transition:transform .4s}\n  .fhx-fam__card:hover .fhx-fam__img{transform:scale(1.04)}\n  .fhx-fam__label{position:absolute;left:0;right:0;bottom:0;padding:3rem 1.2rem 1.2rem;color:#fff;font-size:1.6rem;font-weight:600;\n                  background:linear-gradient(to top,rgba(20,22,32,.8),transparent)}\n  .fhx-fam__label small{display:block;font-size:1.2rem;font-weight:400;opacity:.85}\n  @media(min-width:750px){.fhx-fam__grid{grid-template-columns:repeat(4,1fr);gap:1.6rem}}\n  @media(prefers-reduced-motion:reduce){.fhx-fam__img{transition:none}}\n</style>\n{%- endif -%}",
