    "custom_liquid_BPTe8J": {
      "type": "custom-liquid",
      "name": "Ihr Partner",
      "settings": {
        "custom_liquid": "<section class=\"fhx fhx-sec fhx-why\">\n  <div class=\"fhx-why__head\">\n    <h2>{% if request.locale.iso_code == 'en' %}Your partner from the first sample to your own brand{% elsif request.locale.iso_code == 'ar' %}شريكك من أول عينة حتى علامتك التجارية الخاصة{% else %}Ihr Partner vom ersten Muster bis zur eigenen Marke{% endif %}</h2>\n    <p>{% if request.locale.iso_code == 'en' %}We supply perfumers, brands and founders across Europe – reliably, fully documented and in any quantity.{% elsif request.locale.iso_code == 'ar' %}نورّد لصانعي العطور والعلامات التجارية ورواد الأعمال في جميع أنحاء أوروبا – بموثوقية وتوثيق كامل وبأي كمية.{% else %}Wir beliefern Parfümeure, Marken und Gründer in ganz Europa – zuverlässig, dokumentiert und in jeder Menge.{% endif %}</p>\n  </div>\n  <div class=\"fhx-why__grid\">\n    <div><strong>{% if request.locale.iso_code == 'en' %}Fresh for every order{% elsif request.locale.iso_code == 'ar' %}طازج لكل طلب{% else %}Frisch pro Bestellung{% endif %}</strong><p>{% if request.locale.iso_code == 'en' %}Every fragrance oil is filled only after you order.{% elsif request.locale.iso_code == 'ar' %}يُعبّأ كل زيت عطري بعد طلبك فقط.{% else %}Jedes Duftöl wird erst nach Ihrer Bestellung abgefüllt.{% endif %}</p></div>\n    <div><strong>{% if request.locale.iso_code == 'en' %}6&nbsp;g to 5&nbsp;kg{% elsif request.locale.iso_code == 'ar' %}من 6&nbsp;غ حتى 5&nbsp;كغ{% else %}6&nbsp;g bis 5&nbsp;kg{% endif %}</strong><p>{% if request.locale.iso_code == 'en' %}From sample to production – one source for every quantity.{% elsif request.locale.iso_code == 'ar' %}من العينة حتى الإنتاج – مصدر واحد لجميع الكميات.{% else %}Vom Muster bis zur Produktion – eine Quelle für alle Mengen.{% endif %}</p></div>\n    <div><strong>{% if request.locale.iso_code == 'en' %}Registration from A to Z{% elsif request.locale.iso_code == 'ar' %}التسجيل من الألف إلى الياء{% else %}Registrierung von A bis Z{% endif %}</strong><p>{% if request.locale.iso_code == 'en' %}Our experienced team supports you with product registration.{% elsif request.locale.iso_code == 'ar' %}يرافقك فريقنا ذو الخبرة في تسجيل المنتجات.{% else %}Unser erfahrenes Team begleitet Sie bei der Produktregistrierung.{% endif %}</p></div>\n    <div><strong>{% if request.locale.iso_code == 'en' %}Delivery across Europe{% elsif request.locale.iso_code == 'ar' %}التوصيل في أوروبا{% else %}Lieferung in Europa{% endif %}</strong><p>{% if request.locale.iso_code == 'en' %}Germany 1–2 working days, rest of Europe 1–3 working days.{% elsif request.locale.iso_code == 'ar' %}ألمانيا 1–2 يوم عمل، باقي أوروبا 1–3 أيام عمل.{% else %}Deutschland 1–2 Werktage, übriges Europa 1–3 Werktage.{% endif %}</p></div>\n  </div>\n  <a class=\"fhx-btn fhx-btn--line\" href=\"/pages/uber-uns\">{% if request.locale.iso_code == 'en' %}More about us{% elsif request.locale.iso_code == 'ar' %}المزيد عنا{% else %}Mehr über uns{% endif %}</a>\n</section>\n<style>\n  .fhx-why__head{max-width:40em;margin-bottom:3.2rem}\n  .fhx-why__grid{display:grid;grid-template-columns:1fr;gap:2.4rem;margin-bottom:3.2rem}\n  .fhx-why__grid>div{border-top:2px solid #B8963E;padding-top:1.4rem}\n  .fhx-why__grid strong{display:block;font-size:1.7rem;margin-bottom:.4rem;color:#262B3B}\n  .fhx-why__grid p{font-size:1.45rem}\n  @media(min-width:750px){.fhx-why__grid{grid-template-columns:repeat(4,1fr)}}\n</style>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "custom_liquid_BTJjha": {
      "type": "custom-liquid",
      "name": "foto export",
      "settings": {
        "custom_liquid": "{%- liquid\n  assign en = false\n  if request.locale.iso_code != 'de'\n    assign en = true\n  endif\n  assign r = routes.root_url\n  if r == '/'\n    assign r = ''\n  endif\n-%}\n{%- assign desktop_de = 'https://cdn.shopify.com/s/files/1/0929/4571/1487/files/export-desktop-de.jpg?v=1790865082' -%}\n{%- assign mobile_de  = 'https://cdn.shopify.com/s/files/1/0929/4571/1487/files/export-mobile-de.jpg?v=1790865077' -%}\n{%- assign desktop_en = 'https://cdn.shopify.com/s/files/1/0929/4571/1487/files/export-desktop-en.jpg?v=1790865083' -%}\n{%- assign mobile_en  = 'https://cdn.shopify.com/s/files/1/0929/4571/1487/files/export-mobile-en.jpg?v=1790865076' -%}\n{%- assign link = '/pages/contact' -%}\n{%- assign alt_de = 'Fragrance Hub Germany' -%}\n{%- assign alt_en = 'Fragrance Hub Germany' -%}\n\n{%- liquid\n  if en and desktop_en != ''\n    assign d = desktop_en\n    assign m = mobile_en\n    assign alt = alt_en\n  else\n    assign d = desktop_de\n    assign m = mobile_de\n    assign alt = alt_de\n  endif\n  if m == ''\n    assign m = d\n  endif\n-%}\n{%- if d != '' -%}\n<div class=\"fhbn\">\n  <a class=\"fhbn__link\" href=\"{{ r }}{{ link }}\">\n    <picture>\n      <source media=\"(max-width: 749px)\" srcset=\"{{ m }}\">\n      <img src=\"{{ d }}\" alt=\"{{ alt }}\" loading=\"lazy\" width=\"1920\" height=\"900\">\n    </picture>\n  </a>\n</div>\n<style>\n  .fhbn{max-width:1200px;margin:0 auto;padding:2.4rem 1.6rem}\n  .fhbn__link{display:block;border-radius:6px;overflow:hidden;box-shadow:0 10px 30px rgba(31,36,51,.12);transition:transform .3s,box-shadow .3s}\n  .fhbn__link:hover{transform:translateY(-2px);box-shadow:0 16px 40px rgba(31,36,51,.18)}\n  .fhbn__link:focus-visible{outline:2px solid #B8963E;outline-offset:3px}\n  .fhbn img{display:block;width:100%;height:auto}\n  @media(min-width:750px){.fhbn{padding:4rem 1.6rem}}\n  @media(prefers-reduced-motion:reduce){.fhbn__link{transition:none}}\n</style>\n{%- endif -%}",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_gDaKtz": {
      "type": "custom-liquid",
      "name": "Tester 3 Variante ",
      "settings": {
        "custom_liquid": "{%- assign ps = collections['probiersets'] -%}\n<div class=\"fh-ps\">\n  <div class=\"fh-ps__intro\">\n    <p class=\"fh-ps__kicker\">{% if request.locale.iso_code == 'en' %}New in our range{% elsif request.locale.iso_code == 'ar' %}جديد في تشكيلتنا{% else %}Neu im Sortiment{% endif %}</p>\n    <h2 class=\"fh-ps__title\">{% if request.locale.iso_code == 'en' %}Test first, then order big{% elsif request.locale.iso_code == 'ar' %}جرّب أولاً ثم اطلب بكميات كبيرة{% else %}Erst testen, dann groß bestellen{% endif %}</h2>\n    <p class=\"fh-ps__text\">{% if request.locale.iso_code == 'en' %}Sample sets with 5, 10 or 20 premium perfume oils of 6 g each – ready-made or with your chosen scents. From {{ ps.products.first.price_min | money }} net.{% elsif request.locale.iso_code == 'ar' %}مجموعات عينات من 5 أو 10 أو 20 زيتاً عطرياً ممتازاً بسعة 6 غ لكل منها – جاهزة أو بعطورك المختارة. ابتداءً من {{ ps.products.first.price_min | money }} صافي.{% else %}Probiersets mit 5, 10 oder 20 Premium-Parfümölen à 6 g – fertig zusammengestellt oder mit Ihren Wunschdüften. Ab {{ ps.products.first.price_min | money }} netto.{% endif %}</p>\n    <a class=\"fh-ps__btn\" href=\"{{ ps.url }}\">{% if request.locale.iso_code == 'en' %}View sample sets{% elsif request.locale.iso_code == 'ar' %}عرض مجموعات العينات{% else %}Probiersets ansehen{% endif %}</a>\n  </div>\n  <div class=\"fh-ps__row\">\n    {%- for p in ps.products limit: 4 -%}\n      <a class=\"fh-ps__card\" href=\"{{ p.url }}\">\n        {%- if p.featured_image -%}\n          <img src=\"{{ p.featured_image | image_url: width: 600 }}\" alt=\"{{ p.title | escape }}\" loading=\"lazy\" width=\"600\" height=\"600\">\n        {%- endif -%}\n        <span class=\"fh-ps__name\">{{ p.title | split: ' – ' | first }}</span>\n        <span class=\"fh-ps__price\">{% if request.locale.iso_code == 'en' %}from{% elsif request.locale.iso_code == 'ar' %}من{% else %}ab{% endif %} {{ p.price_min | money }}</span>\n      </a>\n    {%- endfor -%}\n  </div>\n</div>\n<style>\n  .fh-ps{background:#181a28;color:#f0eade;padding:4.8rem 2rem;border-top:1px solid rgba(201,169,110,.35);border-bottom:1px solid rgba(201,169,110,.35)}\n  .fh-ps__intro{max-width:64rem;margin:0 auto 3.2rem;text-align:center}\n  .fh-ps__kicker{margin:0 0 .8rem;color:#c9a96e;font-size:1.4rem;letter-spacing:.08em}\n  .fh-ps__title{margin:0 0 1.2rem;color:#f0eade;font-family:var(--font-heading-family);font-size:clamp(2.6rem,4vw,4rem);line-height:1.2}\n  .fh-ps__text{margin:0 0 2.4rem;font-size:1.6rem;line-height:1.6;opacity:.85}\n  .fh-ps__btn{display:inline-block;padding:1.3rem 3.2rem;background:#c9a96e;color:#181a28;font-size:1.5rem;font-weight:600;text-decoration:none;border-radius:4px}\n  .fh-ps__btn:hover{background:#d8bc86}\n  .fh-ps__btn:focus-visible,.fh-ps__card:focus-visible{outline:2px solid #f0eade;outline-offset:3px}\n  .fh-ps__row{display:grid;grid-template-columns:repeat(4,1fr);gap:1.6rem;max-width:120rem;margin:0 auto}\n  .fh-ps__card{display:flex;flex-direction:column;text-decoration:none;color:#f0eade;border:1px solid rgba(201,169,110,.25);border-radius:6px;overflow:hidden;background:#12131e}\n  .fh-ps__card img{width:100%;height:auto;display:block;aspect-ratio:1/1;object-fit:cover}\n  .fh-ps__name{padding:1.2rem 1.2rem .2rem;font-size:1.5rem}\n  .fh-ps__price{padding:0 1.2rem 1.4rem;color:#c9a96e;font-size:1.4rem}\n  @media (max-width:749px){\n    .fh-ps{padding:3.6rem 0}\n    .fh-ps__intro{padding:0 2rem}\n    .fh-ps__row{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 2rem;gap:1.2rem}\n    .fh-ps__card{flex:0 0 68%;scroll-snap-align:start}\n  }\n</style>",
        "color_scheme": "",
        "padding_top": 100,
        "padding_bottom": 0
      }
    },
    "custom_liquid_8bJBUU": {
