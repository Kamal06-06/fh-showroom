    "custom_liquid_NWNwnr": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- comment -%} Fragrance Hub Parfum-Rechner: gleicher Code für Rechner-Seite UND Produktseite {%- endcomment -%}\n{%- if product -%}\n{%- if product.options contains 'Inhalt' -%}\n<a href=\"{{ routes.root_url | append: '/pages/parfum-rechner?oil=' | replace: '//', '/' }}{{ product.handle }}\"\n   style=\"display:flex;align-items:center;justify-content:center;gap:.5rem;margin:.6rem 0;padding:.8rem 1rem;border:1.5px solid #b3791c;border-radius:8px;color:#1d2b3a;text-decoration:none;font-weight:600\">\n  🧪 {% if request.locale.iso_code == 'de' %}Menge für meine Flakons berechnen{% else %}Calculate amount for my bottles{% endif %}\n</a>\n{%- endif -%}\n{%- else -%}\n<!--\n  Fragrance Hub – Parfum-Rechner\n  Einbau: Onlineshop → Seiten → neue Seite \"Parfum-Rechner\" anlegen →\n  Theme anpassen → diese Seite öffnen → Abschnitt \"Benutzerdefiniertes Liquid\" hinzufügen →\n  diesen gesamten Code einfügen → Speichern.\n  Alle Preise und Varianten kommen live aus dem Shop – keine IDs nötig.\n-->\n<div id=\"fhc\" class=\"fhc\" dir=\"ltr\">\n  <div class=\"fhc-head\">\n    <h2 class=\"fhc-title\" data-t=\"title\"></h2>\n    <p class=\"fhc-lead\" data-t=\"lead\"></p>\n  </div>\n\n  <div class=\"fhc-grid\">\n    <div class=\"fhc-form\">\n      <section class=\"fhc-step\">\n        <h3><span class=\"fhc-n\">1</span><span data-t=\"s1\"></span></h3>\n        <div class=\"fhc-row\">\n          <label><span data-t=\"bottleSize\"></span>\n            <select id=\"fhc-size\">\n              <option value=\"30\">30 ml</option>\n              <option value=\"50\" selected>50 ml</option>\n              <option value=\"100\">100 ml</option>\n              <option value=\"custom\" data-t=\"custom\"></option>\n            </select>\n          </label>\n          <label id=\"fhc-custom-wrap\" hidden><span>ml</span>\n            <input id=\"fhc-custom\" type=\"number\" min=\"1\" max=\"5000\" value=\"75\">\n          </label>\n          <label><span data-t=\"count\"></span>\n            <input id=\"fhc-count\" type=\"number\" min=\"1\" max=\"100000\" value=\"50\">\n          </label>\n        </div>\n      </section>\n\n      <section class=\"fhc-step\">\n        <h3><span class=\"fhc-n\">2</span><span data-t=\"s2\"></span></h3>\n        <div class=\"fhc-presets\" id=\"fhc-presets\"></div>\n        <div class=\"fhc-slider\">\n          <input id=\"fhc-pct\" type=\"range\" min=\"5\" max=\"40\" step=\"1\" value=\"20\" aria-describedby=\"fhc-pct-out\">\n          <output id=\"fhc-pct-out\">20 %</output>\n        </div>\n      </section>\n\n      <section class=\"fhc-step\">\n        <h3><span class=\"fhc-n\">3</span><span data-t=\"s3\"></span></h3>\n        <input id=\"fhc-q\" type=\"search\" autocomplete=\"off\" data-tp=\"searchPh\">\n        <ul id=\"fhc-results\" class=\"fhc-results\" role=\"listbox\"></ul>\n        <div id=\"fhc-oil\" class=\"fhc-picked\" hidden></div>\n      </section>\n\n      <section class=\"fhc-step\">\n        <h3><span class=\"fhc-n\">4</span><span data-t=\"s4\"></span></h3>\n        <label class=\"fhc-check\"><input id=\"fhc-alc-on\" type=\"checkbox\" checked> <span data-t=\"addAlc\"></span></label>\n        <label class=\"fhc-check\"><input id=\"fhc-bot-on\" type=\"checkbox\" checked> <span data-t=\"addBottles\"></span></label>\n        <div id=\"fhc-bot-wrap\" class=\"fhc-row\">\n          <div class=\"fhc-wide fhc-full\"><span class=\"fhc-lbl\" data-t=\"bottleModel\"></span>\n            <div id=\"fhc-bots\" class=\"fhc-bots\" role=\"listbox\"></div>\n          </div>\n          <label class=\"fhc-wide\"><span data-t=\"variant\"></span>\n            <select id=\"fhc-bot-var\"></select>\n          </label>\n        </div>\n      </section>\n    </div>\n\n    <aside class=\"fhc-result\" aria-live=\"polite\">\n      <div class=\"fhc-visual\">\n        <img id=\"fhc-botimg\" class=\"fhc-botimg\" alt=\"\" hidden>\n        <svg viewBox=\"0 0 120 170\" class=\"fhc-bottle\" id=\"fhc-svg\" aria-hidden=\"true\">\n          <defs><clipPath id=\"fhc-clip\"><rect x=\"14\" y=\"44\" width=\"92\" height=\"118\" rx=\"14\"/></clipPath></defs>\n          <rect x=\"44\" y=\"6\" width=\"32\" height=\"22\" rx=\"3\" class=\"fhc-cap\"/>\n          <rect x=\"50\" y=\"28\" width=\"20\" height=\"16\" class=\"fhc-neck\"/>\n          <g clip-path=\"url(#fhc-clip)\">\n            <rect x=\"14\" y=\"44\" width=\"92\" height=\"118\" class=\"fhc-alc\"/>\n            <rect id=\"fhc-oilbar\" x=\"14\" y=\"138\" width=\"92\" height=\"24\" class=\"fhc-oilfill\"/>\n          </g>\n          <rect x=\"14\" y=\"44\" width=\"92\" height=\"118\" rx=\"14\" class=\"fhc-glass\"/>\n        </svg>\n        <div class=\"fhc-amounts\">\n          <div><b id=\"fhc-oil-g\">–</b><span data-t=\"oilLabel\"></span></div>\n          <div><b id=\"fhc-alc-l\">–</b><span data-t=\"alcLabel\"></span></div>\n          <div><b id=\"fhc-total\">–</b><span data-t=\"totalLabel\"></span></div>\n        </div>\n      </div>\n\n      <ul id=\"fhc-lines\" class=\"fhc-lines\"></ul>\n      <div class=\"fhc-sum\"><span data-t=\"sum\"></span><b id=\"fhc-sum\">–</b></div>\n      <p id=\"fhc-msg\" class=\"fhc-msg\" role=\"status\"></p>\n      <button id=\"fhc-add\" class=\"fhc-btn\" type=\"button\" disabled data-t=\"addCart\"></button>\n      <p class=\"fhc-note\" data-t=\"note\"></p>\n    </aside>\n  </div>\n</div>\n\n<style>\n  .fhc{--ink:#1d2b3a;--amber:#b3791c;--amber-soft:#e9c887;--glass:#eef4f7;--line:#d3dbe1;--muted:#5b6977;--paper:#fff;\n    color:var(--ink);max-width:1080px;margin:0 auto;padding:1.5rem 1rem 3rem;font:inherit}\n  .fhc *{box-sizing:border-box}\n  .fhc [hidden]{display:none!important}\n  .fhc-head{max-width:640px;margin-bottom:1.75rem}\n  .fhc-title{margin:0 0 .4rem;font-size:clamp(1.6rem,3.2vw,2.3rem);line-height:1.15}\n  .fhc-lead{margin:0;color:var(--muted);line-height:1.55}\n  .fhc-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:2rem;align-items:start}\n  .fhc-step{padding:1.1rem 0 1.3rem;border-top:1px solid var(--line)}\n  .fhc-step h3{display:flex;align-items:center;gap:.6rem;margin:0 0 .9rem;font-size:1.05rem}\n  .fhc-n{display:inline-grid;place-items:center;width:1.7rem;height:1.7rem;border-radius:50%;background:var(--ink);color:#fff;font-size:.85rem}\n  .fhc-row{display:flex;flex-wrap:wrap;gap:.8rem}\n  .fhc label{display:flex;flex-direction:column;gap:.3rem;font-size:.85rem;color:var(--muted)}\n  .fhc label.fhc-wide{flex:1 1 220px}\n  .fhc input[type=number],.fhc input[type=search],.fhc select{font:inherit;font-size:1rem;color:var(--ink);background:var(--paper);\n    border:1px solid var(--line);border-radius:6px;padding:.6rem .7rem;min-width:120px;width:100%}\n  .fhc input:focus-visible,.fhc select:focus-visible,.fhc button:focus-visible{outline:2px solid var(--amber);outline-offset:2px}\n  .fhc-presets{display:flex;flex-wrap:wrap;gap:.5rem;margin-bottom:.8rem}\n  .fhc-presets button{font:inherit;font-size:.9rem;border:1px solid var(--line);background:var(--paper);color:var(--ink);border-radius:999px;padding:.45rem .9rem;cursor:pointer}\n  .fhc-presets button[aria-pressed=true]{background:var(--ink);border-color:var(--ink);color:#fff}\n  .fhc-slider{display:flex;align-items:center;gap:1rem}\n  .fhc-slider input{flex:1;accent-color:var(--amber)}\n  .fhc-slider output{min-width:3.5rem;font-weight:700;font-size:1.1rem}\n  .fhc-results{list-style:none;margin:.4rem 0 0;padding:0;border:1px solid var(--line);border-radius:6px;overflow:hidden}\n  .fhc-results:empty{display:none}\n  .fhc-results li{display:flex;align-items:center;gap:.7rem;padding:.55rem .7rem;cursor:pointer;border-top:1px solid var(--line)}\n  .fhc-results li:first-child{border-top:0}\n  .fhc-results li:hover,.fhc-results li:focus{background:var(--glass);outline:none}\n  .fhc-results img,.fhc-picked img{width:40px;height:40px;object-fit:cover;border-radius:4px;flex:none}\n  .fhc-picked{display:flex;flex-wrap:wrap;align-items:center;gap:.8rem;margin-top:.7rem;padding:.7rem;background:var(--glass);border-radius:8px}\n  .fhc-picked strong{flex:1 1 140px}\n  .fhc-picked select{width:auto}\n  .fhc-check{flex-direction:row!important;align-items:center;gap:.5rem!important;font-size:.95rem!important;color:var(--ink)!important;margin-bottom:.5rem}\n  .fhc-check input{accent-color:var(--amber);width:1.1rem;height:1.1rem}\n  .fhc-result{position:sticky;top:1.5rem;background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:1.3rem}\n  .fhc-visual{display:flex;gap:1.2rem;align-items:center;margin-bottom:1rem}\n  .fhc-bottle{width:110px;flex:none}\n  .fhc-cap{fill:var(--ink)} .fhc-neck{fill:#c9d4db}\n  .fhc-alc{fill:var(--glass)} .fhc-oilfill{fill:var(--amber);transition:y .45s ease,height .45s ease}\n  .fhc-glass{fill:none;stroke:var(--ink);stroke-width:2.5}\n  .fhc-amounts{display:grid;gap:.7rem}\n  .fhc-amounts div{display:flex;flex-direction:column}\n  .fhc-amounts b{font-size:1.35rem;line-height:1.1}\n  .fhc-amounts span{font-size:.8rem;color:var(--muted)}\n  .fhc-lbl{display:block;margin-bottom:.4rem;font-size:.85rem;color:var(--muted)}\n  .fhc-full{flex-basis:100%!important}\n  .fhc-bots{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:.6rem;max-height:360px;overflow:auto;padding:2px}\n  .fhc-bc{display:flex;flex-direction:column;gap:.3rem;padding:.5rem;border:1px solid var(--line);border-radius:8px;background:var(--paper);font:inherit;text-align:left;cursor:pointer;color:var(--ink)}\n  .fhc-bc img{width:100%;aspect-ratio:1;object-fit:contain;background:#fff;border-radius:4px}\n  .fhc-bc span{font-size:.78rem;line-height:1.25}\n  .fhc-bc small{font-size:.75rem;color:var(--muted)}\n  .fhc-bc[aria-pressed=true]{border-color:var(--amber);box-shadow:0 0 0 2px var(--amber)}\n  .fhc-botimg{width:130px;height:170px;object-fit:contain;flex:none;background:#fff;border-radius:8px}\n  .fhc-lines{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}\n  .fhc-lines li{display:flex;justify-content:space-between;gap:1rem;padding:.55rem 0;border-bottom:1px solid var(--line);font-size:.9rem}\n  .fhc-lines small{display:block;color:var(--muted)}\n  .fhc-sum{display:flex;justify-content:space-between;align-items:baseline;padding:.8rem 0;font-size:1.05rem}\n  .fhc-sum b{font-size:1.4rem}\n  .fhc-msg{min-height:1.2em;margin:.2rem 0 .6rem;font-size:.85rem;color:#a03a2a}\n  .fhc-btn{width:100%;font:inherit;font-weight:700;font-size:1rem;padding:.9rem;border:0;border-radius:8px;background:var(--ink);color:#fff;cursor:pointer}\n  .fhc-btn:disabled{opacity:.45;cursor:not-allowed}\n  .fhc-note{margin:.9rem 0 0;font-size:.8rem;color:var(--muted);line-height:1.5}\n  @media (max-width:820px){.fhc-grid{grid-template-columns:1fr}.fhc-result{position:static}}\n  @media (prefers-reduced-motion:reduce){.fhc-oilfill{transition:none}}\n</style>\n\n<script>\n(function(){\n  /* ====== Einstellungen (bei Bedarf anpassen) ====== */\n  var CFG = {\n    alcoholHandle: 'ethanol-96-kosmetische-qualitaet',\n    bottleCollections: { '30':'parfumflakons-30-ml', '50':'parfumflakons-50-ml', '100':'parfumflakons-100-ml' },\n    oilDensity: 0.95,   // g pro ml Duftöl (Richtwert)\n    wastePct: 3,        // Zuschlag für Verlust beim Abfüllen (%)\n    presets: [ {k:'edt',pct:12}, {k:'edp',pct:20}, {k:'extrait',pct:30} ]\n  };\n\n  var T = {\n    de:{title:'Parfum-Rechner',lead:'Geben Sie ein, wie viele Flakons Sie abfüllen möchten. Der Rechner ermittelt Duftöl, Alkohol und Flakons und wählt die günstigste Gebindekombination aus unserem Sortiment.',\n      s1:'Flakons',bottleSize:'Flakongröße',custom:'Eigene Größe',count:'Anzahl Flakons',s2:'Konzentration',\n      edt:'Eau de Toilette',edp:'Eau de Parfum',extrait:'Extrait',s3:'Duftöl wählen',searchPh:'Name oder Artikelcode, z. B. Naxos',\n      quality:'Qualität',change:'Ändern',s4:'Mit in den Warenkorb',addAlc:'Parfumalkohol (Ethanol 96 %)',addBottles:'Flakons',\n      bottleModel:'Flakon-Modell',variant:'Ausführung',oilLabel:'Duftöl',alcLabel:'Alkohol',totalLabel:'Fertiges Parfum',\n      sum:'Summe',addCart:'Alles in den Warenkorb',adding:'Wird hinzugefügt …',\n      note:'Richtwerte inkl. 3 % Abfüllverlust. Nach dem Mischen einige Tage reifen lassen, dann abfüllen. Sicherheitsdatenblätter und IFRA-Zertifikate erhalten Sie mit der Bestellung.',\n      noOil:'Bitte zuerst ein Duftöl wählen.',noHits:'Kein Duftöl gefunden.',notOil:'Dieses Produkt hat keine Gramm-Größen – bitte ein Duftöl wählen.',\n      loadErr:'Daten konnten nicht geladen werden. Bitte Seite neu laden.',cartErr:'Warenkorb-Fehler: ',none:'Keine Flakons in dieser Größe gefunden.',\n      packs:'Gebinde',pcs:'Stk.',from:'ab',toCart:'Zum Warenkorb'},\n    en:{title:'Perfume calculator',lead:'Enter how many bottles you want to fill. The calculator works out fragrance oil, alcohol and bottles and picks the cheapest combination of pack sizes from our range.',\n      s1:'Bottles',bottleSize:'Bottle size',custom:'Custom size',count:'Number of bottles',s2:'Concentration',\n      edt:'Eau de Toilette',edp:'Eau de Parfum',extrait:'Extrait',s3:'Choose fragrance oil',searchPh:'Name or product code, e.g. Naxos',\n      quality:'Quality',change:'Change',s4:'Add to cart',addAlc:'Perfume alcohol (ethanol 96%)',addBottles:'Bottles',\n      bottleModel:'Bottle model',variant:'Version',oilLabel:'Fragrance oil',alcLabel:'Alcohol',totalLabel:'Finished perfume',\n      sum:'Total',addCart:'Add everything to cart',adding:'Adding …',\n      note:'Estimates include 3% filling loss. Let the blend mature for a few days before bottling. Safety data sheets and IFRA certificates come with your order.',\n      noOil:'Choose a fragrance oil first.',noHits:'No fragrance oil found.',notOil:'This product has no gram sizes – please choose a fragrance oil.',\n      loadErr:'Could not load data. Please reload the page.',cartErr:'Cart error: ',none:'No bottles found in this size.',\n      packs:'packs',pcs:'pcs',from:'from',toCart:'Go to cart'}\n  };\n\n  var loc = ((window.Shopify && Shopify.locale) || document.documentElement.lang || 'de').slice(0,2);\n  var L = T[loc] || T.en;\n  var ROOT = (window.Shopify && Shopify.routes && Shopify.routes.root) || '/';\n  var money = new Intl.NumberFormat(loc==='de'?'de-DE':'en-IE',{style:'currency',currency:'EUR'});\n  var $ = function(id){return document.getElementById(id);};\n\n  /* ---------- Texte setzen ---------- */\n  document.querySelectorAll('#fhc [data-t]').forEach(function(el){ if(L[el.dataset.t]) el.textContent = L[el.dataset.t]; });\n  $('fhc-q').placeholder = L.searchPh;\n\n  /* ---------- Hilfsfunktionen ---------- */\n  function num(s){ return parseFloat(String(s).replace(',','.')); }\n  function grams(s){ if(/pro\\s*gramm|per\\s*gram|بالغرام/i.test(String(s))) return null; var m=String(s).match(/(\\d+(?:[.,]\\d+)?)\\s*(kg|g)\\b/i); if(!m) return null; return Math.round(num(m[1])*(m[2].toLowerCase()==='kg'?1000:1)); }\n  function millis(s){ var m=String(s).match(/(\\d+(?:[.,]\\d+)?)\\s*(ml|l|liter|liters|litre|litres|ltr)\\b/i); if(!m) return null; return Math.round(num(m[1])*(m[2].toLowerCase()==='ml'?1:1000)); }\n  function pieces(s){ var m=String(s).match(/(\\d+)\\s*(st(ü|u)ck|stk|pcs|pieces|pack)/i); return m?parseInt(m[1],10):1; }\n  function gcd(a,b){ return b?gcd(b,a%b):a; }\n  function getJSON(url){ return fetch(url,{headers:{Accept:'application/json'}}).then(function(r){ if(!r.ok) throw new Error(r.status); return r.json(); }); }\n  function product(handle){ return getJSON(ROOT+'products/'+handle+'.js'); }\n  function optVals(p,i){ var o=p.options[i]; return (o&&o.values)?o.values:[]; }\n  function optName(p,i){ var o=p.options[i]; return (o&&o.name)?o.name:String(o||''); }\n  function escapeHTML(s){ return String(s).replace(/[&<>\"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c];}); }\n\n  /* Günstigste Kombination, die mindestens \"need\" abdeckt (Mengen in g oder ml) */\n  function cheapest(need, packs){\n    if(need<=0||!packs.length) return null;\n    var step = packs.reduce(function(a,p){return gcd(a,p.size);},0);\n    var target = Math.ceil(need/step), maxU = Math.max.apply(null,packs.map(function(p){return p.size/step;}));\n    var N = target+maxU, cost=new Float64Array(N+1).fill(Infinity), prev=new Int32Array(N+1).fill(-1);\n    cost[0]=0;\n    for(var j=0;j<N;j++){ if(cost[j]===Infinity) continue;\n      for(var i=0;i<packs.length;i++){ var u=packs[i].size/step, k=j+u; if(k>N) continue;\n        var c=cost[j]+packs[i].price; if(c<cost[k]-1e-9){cost[k]=c;prev[k]=i;} } }\n    var best=-1; for(var t=target;t<=N;t++){ if(cost[t]<Infinity && (best<0||cost[t]<cost[best]-1e-9)) best=t; }\n    if(best<0) return null;\n    var counts={}, at=best; while(at>0){ var i2=prev[at]; counts[i2]=(counts[i2]||0)+1; at-=packs[i2].size/step; }\n    return Object.keys(counts).map(function(i){ return {pack:packs[i],qty:counts[i]}; })\n      .sort(function(a,b){return b.pack.size-a.pack.size;});\n  }\n\n  /* ---------- Zustand ---------- */\n  var S = { oil:null, quality:null, alcohol:null, bottle:null, bottleVar:null };\n\n  /* ---------- Schritt 2: Presets ---------- */\n  var presetBox=$('fhc-presets');\n  CFG.presets.forEach(function(p){\n    var b=document.createElement('button'); b.type='button'; b.textContent=L[p.k]+' · '+p.pct+' %'; b.dataset.pct=p.pct;\n    b.addEventListener('click',function(){ $('fhc-pct').value=p.pct; syncPresets(); calc(); });\n    presetBox.appendChild(b);\n  });\n  function syncPresets(){\n    var v=$('fhc-pct').value; $('fhc-pct-out').textContent=v+' %';\n    presetBox.querySelectorAll('button').forEach(function(b){ b.setAttribute('aria-pressed', b.dataset.pct===v?'true':'false'); });\n  }\n\n  /* ---------- Schritt 3: Duftöl suchen ---------- */\n  var timer;\n  $('fhc-q').addEventListener('input',function(e){\n    clearTimeout(timer); var q=e.target.value.trim();\n    if(q.length<2){ $('fhc-results').innerHTML=''; return; }\n    timer=setTimeout(function(){\n      var url=ROOT+'search/suggest.json?q='+encodeURIComponent(q)+'&resources[type]=product&resources[limit]=8'\n        +'&resources[options][fields]=title,variants.sku,product_type,tag';\n      getJSON(url).then(function(d){\n        var list=(d.resources&&d.resources.results&&d.resources.results.products)||[];\n        var ul=$('fhc-results');\n        if(!list.length){ ul.innerHTML='<li aria-disabled=\"true\">'+L.noHits+'</li>'; return; }\n        ul.innerHTML=list.map(function(p){\n          var img=p.image?'<img src=\"'+p.image+'&width=80\" alt=\"\">':'';\n          return '<li role=\"option\" tabindex=\"0\" data-h=\"'+escapeHTML(p.handle)+'\">'+img+'<span>'+escapeHTML(p.title)+'</span></li>';\n        }).join('');\n      }).catch(function(){ $('fhc-msg').textContent=L.loadErr; });\n    },250);\n  });\n  function pickFromList(e){\n    var li=e.target.closest('li[data-h]'); if(!li) return;\n    if(e.type==='keydown' && e.key!=='Enter') return;\n    chooseOil(li.dataset.h);\n  }\n  $('fhc-results').addEventListener('click',pickFromList);\n  $('fhc-results').addEventListener('keydown',pickFromList);\n\n  function chooseOil(handle){\n    product(handle).then(function(p){\n      var sizeIdx=-1;\n      for(var i=0;i<p.options.length;i++){ if(optVals(p,i).some(function(v){return grams(v);})){ sizeIdx=i; break; } }\n      if(sizeIdx<0){ $('fhc-msg').textContent=L.notOil; return; }\n      S.oil={p:p,sizeIdx:sizeIdx,qualIdx:p.options.length>1?(sizeIdx===0?1:0):-1};\n      S.quality=S.oil.qualIdx>=0?optVals(p,S.oil.qualIdx)[0]:null;\n      $('fhc-results').innerHTML=''; $('fhc-q').value=''; $('fhc-msg').textContent='';\n      renderOil(); calc();\n    }).catch(function(){ $('fhc-msg').textContent=L.loadErr; });\n  }\n  function renderOil(){\n    var o=S.oil, box=$('fhc-oil'), p=o.p, img=p.featured_image?'<img src=\"'+p.featured_image+'&width=80\" alt=\"\">':'';\n    var sel='';\n    if(o.qualIdx>=0){\n      sel='<label>'+escapeHTML(optName(p,o.qualIdx)||L.quality)+'<select id=\"fhc-qual\">'+optVals(p,o.qualIdx).map(function(v){\n        return '<option'+(v===S.quality?' selected':'')+'>'+escapeHTML(v)+'</option>'; }).join('')+'</select></label>';\n    }\n    box.innerHTML=img+'<strong>'+escapeHTML(p.title)+'</strong>'+sel+'<button type=\"button\" class=\"fhc-link\" id=\"fhc-change\">'+L.change+'</button>';\n    box.hidden=false;\n    var q=$('fhc-qual'); if(q) q.addEventListener('change',function(){ S.quality=q.value; calc(); });\n    $('fhc-change').addEventListener('click',function(){ S.oil=null; box.hidden=true; $('fhc-q').focus(); calc(); });\n  }\n  function oilPacks(){\n    var o=S.oil; if(!o) return [];\n    var key='option'+(o.sizeIdx+1), qkey=o.qualIdx>=0?'option'+(o.qualIdx+1):null;\n    var vs=o.p.variants.filter(function(v){ return !qkey||v[qkey]===S.quality; });\n    var avail=vs.filter(function(v){return v.available;}); if(avail.length) vs=avail;\n    return vs.map(function(v){ return {id:v.id,size:grams(v[key]),price:v.price,label:v[key]}; }).filter(function(x){return x.size;});\n  }\n\n  /* ---------- Alkohol ---------- */\n  product(CFG.alcoholHandle).then(function(p){ S.alcohol=p; calc(); }).catch(function(){ $('fhc-alc-on').checked=false; $('fhc-alc-on').disabled=true; });\n  function alcPacks(){\n    if(!S.alcohol) return [];\n    var vs=S.alcohol.variants, avail=vs.filter(function(v){return v.available;}); if(avail.length) vs=avail;\n    return vs.map(function(v){ return {id:v.id,size:millis(v.title),price:v.price,label:v.title}; }).filter(function(x){return x.size;});\n  }\n\n  /* ---------- Flakons ---------- */\n  function loadBottles(){\n    var sz=$('fhc-size').value, h=CFG.bottleCollections[sz], sel=$('fhc-bots'), vsel=$('fhc-bot-var');\n    S.bottle=null; S.bottleVar=null; sel.innerHTML=''; vsel.innerHTML='';\n    if(!h){ $('fhc-bot-wrap').hidden=true; calc(); return; }\n    $('fhc-bot-wrap').hidden=!$('fhc-bot-on').checked;\n    getJSON(ROOT+'collections/'+h+'/products.json?limit=50').then(function(d){\n      var ps=d.products||[];\n      if(!ps.length){ sel.innerHTML='<p>'+L.none+'</p>'; calc(); return; }\n      sel.innerHTML=ps.map(function(p){\n        var img=p.images&&p.images[0]?'<img loading=\"lazy\" src=\"'+sized(p.images[0].src,240)+'\" alt=\"\">':'';\n        var min=Math.min.apply(null,p.variants.map(function(v){return num(v.price);}));\n        return '<button type=\"button\" class=\"fhc-bc\" aria-pressed=\"false\" data-h=\"'+escapeHTML(p.handle)+'\">'+img\n          +'<span>'+escapeHTML(p.title)+'</span><small>'+L.from+' '+money.format(min)+'</small></button>'; }).join('');\n      chooseBottle(ps[0].handle);\n    }).catch(function(){ sel.innerHTML='<p>'+L.none+'</p>'; calc(); });\n  }\n  function sized(u,w){ if(!u) return ''; u=String(u); if(u.indexOf('//')===0) u='https:'+u; return u+(u.indexOf('?')>-1?'&':'?')+'width='+w; }\n  function bottleImg(){ var v=S.bottleVar, p=S.bottle; if(!p) return '';\n    return (v&&v.featured_image&&v.featured_image.src)||p.featured_image||''; }\n  function chooseBottle(handle){\n    $('fhc-bots').querySelectorAll('.fhc-bc').forEach(function(b){ b.setAttribute('aria-pressed', b.dataset.h===handle?'true':'false'); });\n    product(handle).then(function(p){\n      S.bottle=p; var vsel=$('fhc-bot-var');\n      vsel.innerHTML=p.variants.map(function(v){ return '<option value=\"'+v.id+'\"'+(v.available?'':' disabled')+'>'+escapeHTML(v.title)+' – '+money.format(v.price/100)+'</option>'; }).join('');\n      var first=p.variants.find(function(v){return v.available;})||p.variants[0];\n      vsel.value=first.id; S.bottleVar=first; calc();\n    });\n  }\n  $('fhc-bots').addEventListener('click',function(e){ var b=e.target.closest('.fhc-bc'); if(b) chooseBottle(b.dataset.h); });\n  $('fhc-bot-var').addEventListener('change',function(e){\n    S.bottleVar=S.bottle.variants.find(function(v){return String(v.id)===e.target.value;}); calc(); });\n\n  /* ---------- Berechnung ---------- */\n  var lines=[];\n  function calc(){\n    var sz=$('fhc-size').value, ml=sz==='custom'?num($('fhc-custom').value):num(sz);\n    var n=Math.max(0,Math.floor(num($('fhc-count').value)||0)), pct=num($('fhc-pct').value)/100;\n    var total=ml*n*(1+CFG.wastePct/100), oilMl=total*pct, oilG=oilMl*CFG.oilDensity, alcMl=total-oilMl;\n\n    $('fhc-oil-g').textContent = oilG>=1000?(oilG/1000).toFixed(2).replace('.',loc==='de'?',':'.')+' kg':Math.ceil(oilG)+' g';\n    $('fhc-alc-l').textContent = (alcMl/1000).toFixed(2).replace('.',loc==='de'?',':'.')+' L';\n    $('fhc-total').textContent = (total/1000).toFixed(2).replace('.',loc==='de'?',':'.')+' L';\n    var bi=$('fhc-botimg'), src=($('fhc-bot-on').checked&&S.bottleVar)?bottleImg():'';\n    if(src){ var u=sized(src,400); if(bi.getAttribute('src')!==u) bi.src=u; bi.alt=S.bottle.title; bi.hidden=false; $('fhc-svg').style.display='none'; }\n    else { bi.hidden=true; $('fhc-svg').style.display=''; }\n    var h=Math.max(4,118*pct); $('fhc-oilbar').setAttribute('y',162-h); $('fhc-oilbar').setAttribute('height',h);\n\n    lines=[]; var msg='';\n    if(!S.oil) msg=L.noOil;\n    else { var oc=cheapest(Math.ceil(oilG),oilPacks());\n      if(oc) oc.forEach(function(x){ lines.push({id:x.pack.id,qty:x.qty,title:S.oil.p.title,sub:x.pack.label+(S.quality?' · '+S.quality:''),price:x.pack.price*x.qty}); }); }\n    if($('fhc-alc-on').checked && S.alcohol){ var ac=cheapest(Math.ceil(alcMl),alcPacks());\n      if(ac) ac.forEach(function(x){ lines.push({id:x.pack.id,qty:x.qty,title:S.alcohol.title,sub:x.pack.label,price:x.pack.price*x.qty}); }); }\n    if($('fhc-bot-on').checked && S.bottleVar && n>0){ var per=pieces(S.bottleVar.title), q=Math.ceil(n/per);\n      lines.push({id:S.bottleVar.id,qty:q,title:S.bottle.title,sub:S.bottleVar.title+(per>1?' · '+q+' '+L.packs:''),price:S.bottleVar.price*q}); }\n\n    $('fhc-lines').innerHTML=lines.map(function(l){\n      return '<li><span>'+l.qty+' × '+escapeHTML(l.title)+'<small>'+escapeHTML(l.sub)+'</small></span><b>'+money.format(l.price/100)+'</b></li>'; }).join('');\n    var sum=lines.reduce(function(a,l){return a+l.price;},0);\n    $('fhc-sum').textContent=lines.length?money.format(sum/100):'–';\n    $('fhc-msg').textContent=msg;\n    $('fhc-add').disabled=!S.oil||!lines.length||n<1;\n  }\n\n  /* ---------- Warenkorb ---------- */\n  $('fhc-add').addEventListener('click',function(){\n    var btn=this; btn.disabled=true; btn.textContent=L.adding;\n    var errors=[], todo=lines.slice();\n    function next(){\n      if(!todo.length){\n        if(!errors.length){ window.location.href=ROOT+'cart'; return; }\n        $('fhc-msg').innerHTML=L.cartErr+'<br>'+errors.map(escapeHTML).join('<br>')+'<br><a href=\"'+ROOT+'cart\">'+L.toCart+'</a>';\n        btn.disabled=false; btn.textContent=L.addCart; return;\n      }\n      var l=todo.shift();\n      fetch(ROOT+'cart/add.js',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},\n        body:JSON.stringify({items:[{id:l.id,quantity:l.qty}]})})\n        .then(function(r){ return r.json().then(function(j){ if(!r.ok) throw new Error(j.description||j.message||r.status); }); })\n        .catch(function(e){ errors.push(l.qty+' × '+l.title+': '+e.message); })\n        .then(next);\n    }\n    next();\n  });\n\n  /* ---------- Ereignisse ---------- */\n  $('fhc-size').addEventListener('change',function(e){ $('fhc-custom-wrap').hidden=e.target.value!=='custom'; loadBottles(); });\n  ['fhc-custom','fhc-count'].forEach(function(id){ $(id).addEventListener('input',calc); });\n  $('fhc-pct').addEventListener('input',function(){ syncPresets(); calc(); });\n  $('fhc-alc-on').addEventListener('change',calc);\n  $('fhc-bot-on').addEventListener('change',function(){ $('fhc-bot-wrap').hidden=!this.checked||!CFG.bottleCollections[$('fhc-size').value]; calc(); });\n\n  syncPresets(); loadBottles(); calc();\n  var pre=new URLSearchParams(location.search).get('oil'); if(pre) chooseOil(pre);\n})();\n</script>\n<style>.fhc .fhc-link{font:inherit;font-size:.85rem;background:none;border:0;color:var(--ink);text-decoration:underline;cursor:pointer;padding:0}</style>\n\n{%- endif -%}",
