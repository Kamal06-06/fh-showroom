{%- assign fh_docs = product.metafields.custom.dokumente.value -%}
{%- if fh_docs and fh_docs.size > 0 -%}
{%- assign fh_l = request.locale.iso_code | slice: 0, 2 -%}
<div class="fh-docs" {% if fh_l == 'ar' %}dir="rtl"{% endif %}>
  <p class="fh-docs__t">{% case fh_l %}{% when 'ar' %}الشهادات والوثائق{% when 'en' %}Certificates &amp; documents{% else %}Zertifikate &amp; Dokumente{% endcase %}</p>
  {%- for d in fh_docs -%}
  <div class="fh-docs__row">
    {%- if fh_docs.size > 1 -%}
    <span class="fh-docs__q">{% case d.q %}{% when 'Premium' %}{% if fh_l == 'ar' %}بريميوم{% else %}Premium{% endif %}{% when 'Exklusiv' %}{% case fh_l %}{% when 'ar' %}حصري{% when 'en' %}Exclusive{% else %}Exklusiv{% endcase %}{% else %}{% if fh_l == 'ar' %}قياسي{% else %}Standard{% endif %}{% endcase %}</span>
    {%- endif -%}
    <a class="fh-docs__a" href="{{ d.ifra | file_url }}" target="_blank" rel="noopener" download>{% case fh_l %}{% when 'ar' %}شهادة IFRA{% when 'en' %}IFRA certificate{% else %}IFRA-Zertifikat{% endcase %} <small>PDF</small></a>
    {%- if d.sds_en -%}
    <a class="fh-docs__a" href="{{ d.sds_en | file_url }}" target="_blank" rel="noopener" download>{% case fh_l %}{% when 'ar' %}صحيفة بيانات السلامة SDS (EN){% when 'en' %}Safety data sheet (EN){% else %}Sicherheitsdatenblatt (EN){% endcase %} <small>PDF</small></a>
    {%- endif -%}
  </div>
  {%- endfor -%}
</div>
<style>
.fh-docs{margin:1.6rem 0;padding:1.2rem 1.4rem;border:1px solid #E7E1D3;border-radius:12px;background:#FDF7EB}
.fh-docs__t{margin:0 0 .8rem;font-size:1.3rem;letter-spacing:.08em;text-transform:uppercase;color:#1F2433;font-weight:700}
.fh-docs__row{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem;margin:.5rem 0}
.fh-docs__q{min-width:8rem;font-size:1.3rem;color:#1F2433;font-weight:700}
.fh-docs__a{display:inline-flex;align-items:center;gap:.5rem;padding:.6rem 1.1rem;border:1px solid #B8963E;border-radius:10px;background:#fff;color:#1F2433;font-size:1.35rem;text-decoration:none;line-height:1.3}
.fh-docs__a:hover{background:#1F2433;color:#fff;border-color:#1F2433}
.fh-docs__a small{font-size:1rem;color:#B8963E;font-weight:700}
</style>
{%- endif -%}
