      "settings": {
        "custom_liquid": "{%- comment -%}\n FUSSZEILE – Fragrance Hub Germany\n{%- endcomment -%}\n{%- assign fh_tel = '+49 2361 4878835' -%}\n{%- assign fh_tel_link = '+4923614878835' -%}\n{%- assign fh_mail = 'info@fragranceshub.de' -%}\n{%- assign fh_lg = request.locale.iso_code -%}\n{%- assign fh_r = routes.root_url -%}{%- if fh_r == '/' -%}{%- assign fh_r = '' -%}{%- endif -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&display=swap\" rel=\"stylesheet\">\n\n<footer class=\"fhf\" dir=\"ltr\">\n  <div class=\"fhf__wrap\">\n    <div class=\"fhf__top\">\n      <div class=\"fhf__brand\">\n        <p class=\"fhf__name\">Fragrance Hub</p>\n        <p class=\"fhf__country\">Germany</p>\n        <p class=\"fhf__claim\">{% if fh_lg == 'en' %}Wholesale perfume oils – from Germany across Europe, bulk quantities to the Middle East.{% elsif fh_lg == 'ar' %}تجارة الجملة للزيوت العطرية – من ألمانيا إلى كل أوروبا، وكميات كبيرة حتى الشرق الأوسط.{% else %}Großhandel für Parfümöle – aus Deutschland in ganz Europa, Großmengen bis in den Nahen Osten.{% endif %}</p>\n      </div>\n\n      <nav class=\"fhf__col\" aria-label=\"{% if fh_lg == 'en' %}Range{% elsif fh_lg == 'ar' %}التشكيلة{% else %}Sortiment{% endif %}\">\n        <p class=\"fhf__head\">{% if fh_lg == 'en' %}Range{% elsif fh_lg == 'ar' %}التشكيلة{% else %}Sortiment{% endif %}</p>\n        <ul>\n          {%- for l in linklists['main-menu'].links -%}\n            {%- unless l.url contains 'contact' or l.title contains 'Kontakt' or l.title contains 'Neuheiten' -%}\n              <li><a href=\"{{ l.url }}\">{{ l.title | remove: '🆕' | remove: '🔥' | remove: '✨' | strip }}</a></li>\n            {%- endunless -%}\n          {%- endfor -%}\n        </ul>\n      </nav>\n\n      <nav class=\"fhf__col\" aria-label=\"Service\">\n        <p class=\"fhf__head\">{% if fh_lg == 'en' %}Service{% elsif fh_lg == 'ar' %}الخدمات{% else %}Service{% endif %}</p>\n        <ul>\n          <li><a href=\"{{ fh_r }}/pages/uber-uns\">{% if fh_lg == 'en' %}About us{% elsif fh_lg == 'ar' %}من نحن{% else %}Über uns{% endif %}</a></li>\n          <li><a href=\"{{ fh_r }}/pages/parfum-rechner\">{% if fh_lg == 'en' %}Perfume calculator{% elsif fh_lg == 'ar' %}حاسبة العطور{% else %}Parfum-Rechner{% endif %}</a></li>\n          <li><a href=\"{{ fh_r }}/pages/schnellbestellung\">{% if fh_lg == 'en' %}Quick order{% elsif fh_lg == 'ar' %}طلب سريع{% else %}Schnellbestellung{% endif %}</a></li>\n          <li><a href=\"{{ fh_r }}/pages/zertifikate\">{% if fh_lg == 'en' %}Safety data sheets &amp; certificates{% elsif fh_lg == 'ar' %}صحائف بيانات السلامة والشهادات{% else %}Sicherheitsdatenblätter &amp; Zertifikate{% endif %}</a></li>\n          <li><a href=\"{{ fh_r }}/pages/contact\">{% if fh_lg == 'en' %}Request samples &amp; bulk quantities{% elsif fh_lg == 'ar' %}اطلب عينات وكميات كبيرة{% else %}Muster &amp; Großmengen anfragen{% endif %}</a></li>\n          <li><a href=\"{{ fh_r }}/account\">{% if fh_lg == 'en' %}Customer account{% elsif fh_lg == 'ar' %}حساب العميل{% else %}Kundenkonto{% endif %}</a></li>\n          <li><a href=\"{{ fh_r }}/pages/geschaeftskunde-werden\">{% if fh_lg == 'en' %}Become a business customer{% elsif fh_lg == 'ar' %}التسجيل كعميل تجاري{% else %}Geschäftskunde werden{% endif %}</a></li>\n          <li><a href=\"{{ fh_r }}/pages/zertifikate-anfordern\">{% if fh_lg == 'en' %}Request certificates{% elsif fh_lg == 'ar' %}طلب الشهادات{% else %}Zertifikate anfordern{% endif %}</a></li>\n        </ul>\n      </nav>\n\n      <div class=\"fhf__col\">\n        <p class=\"fhf__head\">{% if fh_lg == 'en' %}Contact{% elsif fh_lg == 'ar' %}اتصل بنا{% else %}Kontakt{% endif %}</p>\n        <address class=\"fhf__addr\">\n          Fragrance Hub Germany<br>\n          Am Alten Kirchplatz 10<br>\n          45665 Recklinghausen\n        </address>\n        <p class=\"fhf__line\"><a href=\"tel:{{ fh_tel_link }}\">{{ fh_tel }}</a></p>\n        <p class=\"fhf__line\"><a href=\"mailto:{{ fh_mail }}\">{{ fh_mail }}</a></p>\n        <p class=\"fhf__hours\">{% if fh_lg == 'en' %}Phone hours 1:30–4:30 pm<br>Visits by appointment{% elsif fh_lg == 'ar' %}متاحون هاتفياً من 13:30 حتى 16:30<br>الزيارة بموعد مسبق{% else %}Telefonisch erreichbar 13:30–16:30 Uhr<br>Besuch nach Terminvereinbarung{% endif %}</p>\n      </div>\n    </div>\n\n    <div class=\"fhf__mid\">\n      <ul class=\"fhf__facts\">\n        <li>{% if fh_lg == 'en' %}Same-day shipping for orders by 12 noon{% elsif fh_lg == 'ar' %}شحن في نفس اليوم للطلبات قبل الساعة 12 ظهراً{% else %}Versand am selben Tag bei Bestellung bis 12 Uhr{% endif %}</li>\n        <li>{% if fh_lg == 'en' %}IFRA &amp; safety data sheet for every fragrance oil{% elsif fh_lg == 'ar' %}شهادة IFRA وصحيفة السلامة لكل زيت عطري{% else %}IFRA &amp; Sicherheitsdatenblatt zu jedem Duftöl{% endif %}</li>\n        <li>{% if fh_lg == 'en' %}From 6 g samples to over 1,000 kg{% elsif fh_lg == 'ar' %}من عينة 6 غ حتى أكثر من 1000 كغ{% else %}Vom 6-g-Muster bis über 1.000 kg{% endif %}</li>\n      </ul>\n      {%- if shop.enabled_payment_types.size > 0 -%}\n        <ul class=\"fhf__pay\" aria-label=\"{% if fh_lg == 'en' %}Payment methods{% elsif fh_lg == 'ar' %}طرق الدفع{% else %}Zahlungsarten{% endif %}\">\n          {%- for t in shop.enabled_payment_types -%}<li>{{ t | payment_type_svg_tag: class: 'fhf__payicon' }}</li>{%- endfor -%}\n        </ul>\n      {%- endif -%}\n    </div>\n\n    <div class=\"fhf__bottom\">\n      <p>© {{ 'now' | date: '%Y' }} Fragrance Hub Germany. {% if fh_lg == 'en' %}All prices plus VAT.{% elsif fh_lg == 'ar' %}جميع الأسعار غير شاملة الضريبة.{% else %}Alle Preise zzgl. MwSt.{% endif %}</p>\n      <ul class=\"fhf__legal\">\n        {%- if shop.policies.size > 0 -%}\n          {%- for p in shop.policies -%}<li><a href=\"{{ p.url }}\">{{ p.title }}</a></li>{%- endfor -%}\n        {%- endif -%}\n        <li><a href=\"{{ fh_r }}/pages/cookie-einstellungen\">{% if fh_lg == 'en' %}Cookie settings{% elsif fh_lg == 'ar' %}إعدادات ملفات تعريف الارتباط{% else %}Cookie-Einstellungen{% endif %}</a></li>\n        <li><a class=\"fhf__wr\" href=\"{{ fh_r }}/pages/widerruf\">{% if fh_lg == 'en' %}Withdraw from contract{% elsif fh_lg == 'ar' %}إلغاء العقد (Widerruf){% else %}Vertrag widerrufen{% endif %}</a></li>\n      </ul>\n    </div>\n  </div>\n</footer>\n\n<style>\n  .fhf{background:#1F2433;color:rgba(255,255,255,.75);font-size:1.4rem;line-height:1.6;text-align:left}\n  .fhf a{color:rgba(255,255,255,.8);text-decoration:none;transition:color .2s}\n  .fhf a:hover{color:#D9BF7A}\n  .fhf a:focus-visible{outline:2px solid #D9BF7A;outline-offset:2px}\n  .fhf__wrap{max-width:1200px;margin:0 auto;padding:5.6rem 1.6rem 2.4rem}\n  .fhf__top{display:grid;grid-template-columns:1fr;gap:3.6rem;padding-bottom:4rem;border-bottom:1px solid rgba(217,191,122,.25)}\n  .fhf__name{font-family:'Cormorant Garamond',Georgia,serif;font-weight:600;font-size:3.6rem;line-height:1;color:#D9BF7A;margin:0}\n  .fhf__country{font-family:'Cormorant Garamond',Georgia,serif;font-size:1.4rem;letter-spacing:.7rem;text-transform:uppercase;color:#D9BF7A;opacity:.85;margin:.6rem 0 1.6rem}\n  .fhf__claim{margin:0;max-width:30em}\n  .fhf__head{margin:0 0 1.4rem;font-size:1.3rem;font-weight:700;color:#fff;letter-spacing:.05rem}\n  .fhf__col ul{list-style:none;margin:0;padding:0;display:grid;gap:.8rem}\n  .fhf__addr{font-style:normal;margin:0 0 1.2rem}\n  .fhf__line{margin:0 0 .4rem}\n  .fhf__hours{margin:1.2rem 0 0;font-size:1.3rem;color:rgba(255,255,255,.55)}\n  .fhf__mid{display:flex;flex-direction:column;gap:2.4rem;padding:2.8rem 0;border-bottom:1px solid rgba(255,255,255,.08)}\n  .fhf__facts{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:.8rem}\n  .fhf__facts li{position:relative;padding-left:2rem;font-size:1.35rem}\n  .fhf__facts li::before{content:\"\";position:absolute;left:0;top:.75em;width:.8rem;height:1px;background:#D9BF7A}\n  .fhf__pay{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.6rem}\n  .fhf__payicon{height:2.4rem;width:auto;display:block}\n  .fhf__bottom{display:flex;flex-direction:column;gap:1.2rem;padding-top:2.4rem;font-size:1.25rem;color:rgba(255,255,255,.5)}\n  .fhf__bottom p{margin:0}\n  .fhf__legal{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:.6rem 1.8rem}\n  .fhf__legal a{color:rgba(255,255,255,.55)}\n  .fhf__legal a.fhf__wr{color:#D9BF7A;border:1px solid rgba(217,191,122,.55);border-radius:3px;padding:.3rem 1.1rem;font-weight:600}\n  .fhf__legal a.fhf__wr:hover{background:#B8963E;color:#1F2433}\n  @media(min-width:750px){\n    .fhf__top{grid-template-columns:1.6fr 1fr 1fr 1.2fr;gap:4rem}\n    .fhf__mid{flex-direction:row;justify-content:space-between;align-items:center}\n    .fhf__facts{flex-direction:row;gap:3.2rem}\n    .fhf__bottom{flex-direction:row;justify-content:space-between;align-items:center}\n  }\n</style>",
        "color_scheme": "scheme-1",
