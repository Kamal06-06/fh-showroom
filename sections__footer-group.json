      "settings": {
        "custom_liquid": "{%- liquid\n  assign en = false\n  if request.locale.iso_code == 'en'\n    assign en = true\n  endif\n  assign r = routes.root_url\n  if r == '/'\n    assign r = ''\n  endif\n-%}\n{%- comment -%}\n MENÜ-KARTE – fügt unten in das Handy-Menü (☰) eine Service-Karte ein.\n Als \"Benutzerdefiniertes Liquid\" in der FUSSZEILE einfügen (wirkt auf allen Seiten).\n{%- endcomment -%}\n<template id=\"fh-menu-card\">\n  <div class=\"fhm\">\n    <p class=\"fhm__kicker\">{% if en %}Wholesale &amp; samples{% else %}Großhandel &amp; Muster{% endif %}</p>\n    <p class=\"fhm__title\">{% if en %}Not sure which scent fits?{% else %}Unsicher, welcher Duft passt?{% endif %}</p>\n    <p class=\"fhm__text\">{% if en %}Order samples from 6&nbsp;g or ask us directly – we answer quickly.{% else %}Bestellen Sie Muster ab 6&nbsp;g oder fragen Sie uns direkt – wir antworten schnell.{% endif %}</p>\n    <div class=\"fhm__btns\">\n      <a class=\"fhm__btn fhm__btn--gold\" href=\"https://wa.me/4923614878835\" target=\"_blank\" rel=\"noopener\">WhatsApp</a>\n      <a class=\"fhm__btn\" href=\"{{ r }}/pages/contact\">{% if en %}Request samples{% else %}Muster anfragen{% endif %}</a>\n    </div>\n    <ul class=\"fhm__facts\">\n      <li>{% if en %}Same-day dispatch for orders by 12 noon{% else %}Versand heute bei Bestellung bis 12 Uhr{% endif %}</li>\n      <li>{% if en %}Showroom in Recklinghausen – by appointment{% else %}Showroom in Recklinghausen – nach Termin{% endif %}</li>\n    </ul>\n  </div>\n</template>\n\n<style>\n  .fhm{margin:2.4rem 2rem 0;padding:2rem;border-radius:6px;background:#1F2433;color:#fff;\n    background-image:radial-gradient(ellipse 80% 70% at 100% 0%,rgba(184,150,62,.25),transparent 70%)}\n  .fhm__kicker{margin:0 0 .6rem;font-size:1.1rem;letter-spacing:.2rem;text-transform:uppercase;color:#D9BF7A}\n  .fhm__title{margin:0 0 .6rem;font-size:1.8rem;font-weight:700;line-height:1.25;color:#fff}\n  .fhm__text{margin:0 0 1.6rem;font-size:1.35rem;line-height:1.5;color:rgba(255,255,255,.78)}\n  .fhm__btns{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}\n  .fhm__btn{display:flex;align-items:center;justify-content:center;min-height:4.4rem;padding:0 1rem;border-radius:3px;\n    border:1px solid rgba(217,191,122,.6);color:#fff;font-size:1.35rem;font-weight:600;text-decoration:none;text-align:center}\n  .fhm__btn--gold{background:#B8963E;border-color:#B8963E;color:#1F2433}\n  .fhm__btn:focus-visible{outline:2px solid #D9BF7A;outline-offset:2px}\n  .fhm__facts{list-style:none;margin:1.6rem 0 0;padding:1.4rem 0 0;border-top:1px solid rgba(255,255,255,.12);display:grid;gap:.6rem}\n  .fhm__facts li{position:relative;padding-left:1.8rem;font-size:1.25rem;color:rgba(255,255,255,.7)}\n  .fhm__facts li::before{content:\"\";position:absolute;left:0;top:.75em;width:.8rem;height:1px;background:#D9BF7A}\n  /* Menü allgemein */\n  .menu-drawer{background:#fff}\n  .menu-drawer__menu-item{font-weight:500}\n  .menu-drawer__menu>li:first-child{border-top:1px solid #EEE9DD}\n</style>\n\n<script>\n(function(){\n  function insert(){\n    var drawer = document.querySelector('#menu-drawer, .menu-drawer');\n    var tpl = document.getElementById('fh-menu-card');\n    if (!drawer || !tpl || drawer.querySelector('.fhm')) return;\n    var target = drawer.querySelector('.menu-drawer__utility-links');\n    var card = tpl.content.cloneNode(true);\n    if (target) target.parentNode.insertBefore(card, target);\n    else (drawer.querySelector('.menu-drawer__navigation-container') || drawer).appendChild(card);\n  }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', insert); else insert();\n})();\n</script>",
